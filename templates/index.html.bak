<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Zenserve - All-in-One Home & Local Services for Mohali / Chandigarh</title>
  <meta name="description" content="Zenserve connects residents of Mohali and Chandigarh with trusted local services: AC repair, plumbers, electricians, home cleaners, cab booking, and home blood tests.">
  
  <!-- Modern Inter & Outfit Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Space+Grotesk:wght@500;600;700;800;900&display=swap" rel="stylesheet">

    <style>
        /* ==========================================================================
       ZENSERVE MONOCHROME THEME SYSTEM (Light Mode & Dark Mode)
       Using the same CSS variables for seamless theme switching.
       Saved in localStorage ('zenserve_theme').
       ========================================================================== */
    :root, [data-theme="light"] {
      /* Palette */
      --black: #000000;
      --gray-900: #111111;
      --gray-700: #333333;
      --gray-500: #666666;
      --gray-300: #CCCCCC;
      --gray-200: #E5E5E5;
      --gray-100: #F5F5F5;
      --white: #FFFFFF;

      /* LIGHT MODE: White background with Black text */
      --bg-body: #FFFFFF;
      --bg-card: #FFFFFF;
      --bg-alt: #F5F5F5;
      --bg-header: #FFFFFF;
      --bg-input: #FFFFFF;

      --text-main: #000000;
      --text-muted: #333333;
      --text-light: #666666;
      --text-inverse: #FFFFFF;

      --border-color: #000000;
      --border-light: #E5E5E5;
      --border-thick: 2px solid #000000;
      --border-extra-thick: 3px solid #000000;

      --shadow-sm: 2px 2px 0px #000000;
      --shadow-md: 4px 4px 0px #000000;
      --shadow-lg: 6px 6px 0px #000000;
      --shadow-hover: 6px 6px 0px #000000;
      --shadow-brutal: 4px 4px 0px #000000;
      --shadow-brutal-lg: 8px 8px 0px #000000;

      --primary: #000000;
      --primary-hover: #111111;
      --primary-light: #F5F5F5;
      --primary-border: #000000;
      --accent: #111111;
      --accent-light: #E5E5E5;
      --success: #000000;
      --success-light: #F5F5F5;
      --danger: #E00000;

      /* Button Themes */
      --btn-primary-bg: #000000;
      --btn-primary-text: #FFFFFF;
      --btn-primary-hover-bg: #FFFFFF;
      --btn-primary-hover-text: #000000;

      --btn-secondary-bg: #FFFFFF;
      --btn-secondary-text: #000000;
      --btn-secondary-hover-bg: #000000;
      --btn-secondary-hover-text: #FFFFFF;

      /* Card Hover Inversion */
      --card-hover-bg: #000000;
      --card-hover-text: #FFFFFF;
      --card-hover-desc: #CCCCCC;

      --radius-sm: 4px;
      --radius-md: 4px;
      --radius-lg: 4px;
      --radius-full: 9999px;

      --transition: all 0.15s cubic-bezier(0.16, 1, 0.3, 1);

      /* Emergency / SOS Exception */
      --sos-red: #E00000;
      --sos-red-hover: #B80000;
      --sos-red-light: #FEE2E2;
    }

    [data-theme="dark"] {
      /* DARK MODE: Black background with White text using the SAME CSS variables */
      --bg-body: #000000;
      --bg-card: #0A0A0A;
      --bg-alt: #161616;
      --bg-header: #000000;
      --bg-input: #111111;

      --text-main: #FFFFFF;
      --text-muted: #CCCCCC;
      --text-light: #999999;
      --text-inverse: #000000;

      --border-color: #FFFFFF;
      --border-light: #333333;
      --border-thick: 2px solid #FFFFFF;
      --border-extra-thick: 3px solid #FFFFFF;

      --shadow-sm: 2px 2px 0px #FFFFFF;
      --shadow-md: 4px 4px 0px #FFFFFF;
      --shadow-lg: 6px 6px 0px #FFFFFF;
      --shadow-hover: 6px 6px 0px #FFFFFF;
      --shadow-brutal: 4px 4px 0px #FFFFFF;
      --shadow-brutal-lg: 8px 8px 0px #FFFFFF;

      --primary: #FFFFFF;
      --primary-hover: #E5E5E5;
      --primary-light: #222222;
      --primary-border: #FFFFFF;
      --accent: #E5E5E5;
      --accent-light: #222222;
      --success: #FFFFFF;
      --success-light: #222222;
      --danger: #E00000;

      /* Button Themes (Inverted for Dark Mode) */
      --btn-primary-bg: #FFFFFF;
      --btn-primary-text: #000000;
      --btn-primary-hover-bg: #000000;
      --btn-primary-hover-text: #FFFFFF;

      --btn-secondary-bg: #000000;
      --btn-secondary-text: #FFFFFF;
      --btn-secondary-hover-bg: #FFFFFF;
      --btn-secondary-hover-text: #000000;

      /* Card Hover Inversion */
      --card-hover-bg: #FFFFFF;
      --card-hover-text: #000000;
      --card-hover-desc: #333333;

      /* Emergency / SOS stays vivid red */
      --sos-red: #E00000;
      --sos-red-hover: #B80000;
      --sos-red-light: #350B0B;
    }

    /* ==========================================================================
       BASE RESET & TYPOGRAPHY
       ========================================================================== */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background-color: var(--bg-body);
      color: var(--text-main);
      font-size: 1.1rem;
      font-weight: 500;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    h1, h2, h3, h4, h5, .brand-title, .section-title, .hero-title, .service-name, .provider-name {
      font-family: 'Space Grotesk', 'Inter', sans-serif;
      font-weight: 800;
      color: var(--black);
      letter-spacing: -0.03em;
      line-height: 1.15;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    button, input, select, textarea {
      font-family: 'Inter', 'Space Grotesk', sans-serif;
    }

    .container {
      width: 100%;
      max-width: 1240px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    /* Buttons & Touch Targets */
    button {
      touch-action: manipulation;
    }


    /* ==========================================================================
       THIN SCROLLING BLACK STRIP (MARQUEE TICKER)
       ========================================================================== */
    .marquee-strip {
      background: #000000;
      color: #FFFFFF;
      overflow: hidden;
      white-space: nowrap;
      border-bottom: 2px solid var(--border-color);
      display: flex;
      align-items: center;
      height: 40px;
      user-select: none;
      cursor: default;
      position: relative;
      z-index: 10;
    }

    [data-theme="dark"] .marquee-strip {
      background: #000000;
      border-bottom: 2px solid #333333;
    }

    .marquee-track {
      display: inline-flex;
      white-space: nowrap;
      animation: marqueeScroll 28s linear infinite;
      will-change: transform;
    }

    /* Pause animation on hover */
    .marquee-strip:hover .marquee-track {
      animation-play-state: paused;
    }

    .marquee-content {
      display: inline-block;
      font-family: 'Space Grotesk', 'Inter', sans-serif;
      font-size: 0.9rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      color: #FFFFFF;
      line-height: 40px;
    }

    @keyframes marqueeScroll {
      0% {
        transform: translateX(0);
      }
      100% {
        transform: translateX(-50%);
      }
    }

    /* ==========================================================================
       TOP NAVIGATION
       ========================================================================== */
    .site-header {
      position: sticky;
      top: 0;
      background: var(--bg-card);
      border-bottom: 3px solid var(--border-color);
      z-index: 1000;
      height: 78px;
      display: flex;
      align-items: center;
    }

    .nav-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      padding-right: 95px; /* Reserves space for fixed top-right SOS button */
    }

    .brand-group {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      cursor: pointer;
    }

    .brand-logo-icon {
      width: 44px;
      height: 44px;
      background: #000000;
      color: #FFFFFF;
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.35rem;
      box-shadow: 2px 2px 0px var(--border-color);
    }

    .brand-title-box {
      display: flex;
      flex-direction: column;
    }

    .brand-title {
      font-size: 1.6rem;
      font-weight: 900;
      letter-spacing: -0.04em;
      color: #000000;
      text-transform: uppercase;
      line-height: 1;
    }

    .brand-title span {
      color: #000000;
      text-decoration: underline;
      text-decoration-thickness: 3px;
    }

    .city-badge {
      font-size: 0.78rem;
      font-weight: 800;
      color: #333333;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      margin-top: 0.15rem;
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 0.85rem;
    }

    .nav-link {
      font-size: 0.95rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #000000;
      padding: 0.55rem 0.95rem;
      border: 2px solid transparent;
      border-radius: var(--radius-sm);
      transition: var(--transition);
      cursor: pointer;
    }

    .nav-link:hover {
      background: #F5F5F5;
      border-color: #000000;
    }

    .btn-cab-nav {
      background: #000000;
      color: #FFFFFF;
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 0.65rem 1.25rem;
      font-size: 0.92rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      min-height: 48px;
      box-shadow: 3px 3px 0px var(--border-color);
      transition: var(--transition);
    }

    .btn-cab-nav:hover {
      background: var(--bg-card);
      color: #000000;
      transform: translate(-2px, -2px);
      box-shadow: 5px 5px 0px var(--border-color);
    }

    
    /* Theme Toggle Button */
    .btn-theme-toggle {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      background: var(--btn-secondary-bg);
      border: 2px solid var(--border-color);
      color: var(--btn-secondary-text);
      border-radius: var(--radius-sm);
      padding: 0.65rem 1.15rem;
      font-size: 0.92rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      cursor: pointer;
      min-height: 48px;
      box-shadow: 3px 3px 0px var(--border-color);
      transition: var(--transition);
      user-select: none;
    }

    .btn-theme-toggle:hover {
      background: var(--btn-secondary-hover-bg);
      color: var(--btn-secondary-hover-text);
      transform: translate(-2px, -2px);
      box-shadow: 5px 5px 0px var(--border-color);
    }

    .btn-bookings {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      background: var(--bg-card);
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      color: #000000;
      padding: 0.65rem 1.25rem;
      font-size: 0.92rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      cursor: pointer;
      min-height: 48px;
      box-shadow: 3px 3px 0px var(--border-color);
      transition: var(--transition);
    }

    .btn-bookings:hover {
      background: #000000;
      color: #FFFFFF;
      transform: translate(-2px, -2px);
      box-shadow: 5px 5px 0px var(--border-color);
    }

    .btn-bookings:hover .booking-counter-pill {
      background: var(--bg-card);
      color: #000000;
    }

    .booking-counter-pill {
      background: #000000;
      color: #FFFFFF;
      font-size: 0.75rem;
      font-weight: 900;
      padding: 0.15rem 0.5rem;
      border-radius: 999px;
      line-height: 1;
    }

    /* ==========================================================================
       HERO SECTION
       ========================================================================== */
    .hero-section {
      background: var(--bg-card);
      border-bottom: 3px solid var(--border-color);
      padding: 5rem 0 4rem 0;
    }

    .hero-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      background: #F5F5F5;
      border: 2px solid var(--border-color);
      padding: 0.4rem 1.15rem;
      border-radius: var(--radius-full);
      font-size: 0.85rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #000000;
      margin-bottom: 1.5rem;
      box-shadow: 2px 2px 0px var(--border-color);
    }

    .hero-title {
      font-size: clamp(2.5rem, 7vw, 5rem);
      font-weight: 900;
      letter-spacing: -0.04em;
      line-height: 1.05;
      color: #000000;
      text-transform: uppercase;
      margin-bottom: 1.25rem;
    }

    .hero-title span {
      background: #000000;
      color: #FFFFFF;
      padding: 0 0.45rem;
      display: inline-block;
    }

    .hero-subtitle {
      font-size: 1.25rem;
      font-weight: 500;
      line-height: 1.6;
      color: var(--gray-700);
      max-width: 800px;
      margin-bottom: 2.25rem;
    }

    .search-bar-wrapper {
      max-width: 820px;
      margin-bottom: 1.75rem;
    }

    .search-bar {
      display: flex;
      align-items: center;
      background: var(--bg-card);
      border: 3px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 0.5rem 0.5rem 0.5rem 1.25rem;
      box-shadow: 6px 6px 0px var(--border-color);
      min-height: 64px;
    }

    .search-icon {
      font-size: 1.35rem;
      color: #000000;
      margin-right: 0.85rem;
    }

    .search-input {
      flex: 1;
      border: none;
      outline: none;
      font-size: 1.2rem;
      font-weight: 600;
      color: #000000;
      background: transparent;
    }

    .search-input::placeholder {
      color: var(--gray-500);
      font-weight: 500;
    }

    .search-btn {
      background: #000000;
      color: #FFFFFF;
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 0.85rem 2rem;
      font-size: 1rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      cursor: pointer;
      min-height: 48px;
      transition: var(--transition);
    }

    .search-btn:hover {
      background: var(--bg-card);
      color: #000000;
    }

    .hero-chips {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.65rem;
    }

    .chip-label {
      font-size: 0.85rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--gray-700);
      margin-right: 0.25rem;
    }

    .quick-chip {
      background: var(--bg-card);
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      color: #000000;
      padding: 0.45rem 0.95rem;
      font-size: 0.88rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      cursor: pointer;
      box-shadow: 2px 2px 0px var(--border-color);
      transition: var(--transition);
    }

    .quick-chip:hover {
      background: #000000;
      color: #FFFFFF;
      transform: translate(-2px, -2px);
      box-shadow: 4px 4px 0px var(--border-color);
    }

    /* ==========================================================================
       SECTION HEADINGS (GLOBAL)
       ========================================================================== */
    .section-header {
      margin-bottom: 2.75rem;
    }

    .section-eyebrow {
      display: inline-block;
      font-size: 0.85rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: #000000;
      border-bottom: 2px solid #000000;
      margin-bottom: 0.5rem;
      padding-bottom: 0.15rem;
    }

    .section-title {
      font-size: clamp(2rem, 4.5vw, 3rem);
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: -0.03em;
      color: #000000;
      margin-bottom: 0.75rem;
    }

    .section-desc {
      font-size: 1.15rem;
      font-weight: 500;
      color: var(--gray-700);
      max-width: 720px;
    }

    /* ==========================================================================
       CATEGORY CARDS GRID (The 6 Services)
       White background, 2px thick black border, bold label.
       ON HOVER: Invert to solid black with white text!
       ========================================================================== */
    .services-section {
      background: #FAFAFA;
      border-bottom: 3px solid var(--border-color);
      padding: 5rem 0;
    }

    .services-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.75rem;
    }

    .service-card {
      background: var(--bg-card);
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 2.25rem 1.85rem;
      box-shadow: 4px 4px 0px var(--border-color);
      cursor: pointer;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
      position: relative;
    }

    /* Hover Inversion Effect */
    .service-card:hover {
      background: #000000;
      color: #FFFFFF;
      transform: translate(-3px, -3px);
      box-shadow: 7px 7px 0px var(--border-color);
    }

    .service-card:hover .service-name,
    .service-card:hover .service-price-value,
    .service-card:hover .service-action-link {
      color: #FFFFFF;
    }

    .service-card:hover .service-desc {
      color: #CCCCCC;
    }

    .service-card:hover .service-icon-box {
      background: var(--bg-card);
      color: #000000;
      border-color: #FFFFFF;
    }

    .service-card:hover .service-badge {
      background: var(--bg-card);
      color: #000000;
      border-color: #FFFFFF;
    }

    .service-card-top {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      margin-bottom: 1.5rem;
    }

    .service-icon-box {
      width: 58px;
      height: 58px;
      background: #F5F5F5;
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.85rem;
      transition: var(--transition);
    }

    .service-badge {
      background: #000000;
      color: #FFFFFF;
      border: 1.5px solid var(--border-color);
      font-size: 0.75rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      padding: 0.3rem 0.7rem;
      border-radius: var(--radius-full);
      transition: var(--transition);
    }

    .service-name {
      font-size: 1.55rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: -0.02em;
      margin-bottom: 0.55rem;
      color: #000000;
      transition: color 0.18s ease;
    }

    .service-desc {
      font-size: 1.05rem;
      font-weight: 500;
      color: var(--gray-700);
      line-height: 1.5;
      margin-bottom: 1.75rem;
      transition: color 0.18s ease;
    }

    .service-card-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-top: 2px solid #000000;
      padding-top: 1.25rem;
      margin-top: auto;
    }

    .service-card:hover .service-card-footer {
      border-color: #333333;
    }

    .service-price-box {
      display: flex;
      flex-direction: column;
    }

    .service-price-label {
      font-size: 0.75rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--gray-500);
    }

    .service-card:hover .service-price-label {
      color: #AAAAAA;
    }

    .service-price-value {
      font-size: 1.35rem;
      font-weight: 900;
      letter-spacing: -0.02em;
      color: #000000;
      transition: color 0.18s ease;
    }

    .service-action-link {
      font-size: 0.9rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #000000;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      transition: color 0.18s ease;
    }

    /* ==========================================================================
       PROVIDERS DIRECTORY SECTION
       ========================================================================== */
    .providers-section {
      background: var(--bg-card);
      border-bottom: 3px solid var(--border-color);
      padding: 5rem 0;
    }

    .filter-toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 1.25rem;
      margin-bottom: 2.5rem;
    }

    .filter-pills-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.65rem;
    }

    .filter-pill {
      background: var(--bg-card);
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      color: #000000;
      font-size: 0.92rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      padding: 0.65rem 1.25rem;
      cursor: pointer;
      box-shadow: 2px 2px 0px var(--border-color);
      min-height: 48px;
      transition: var(--transition);
    }

    .filter-pill:hover {
      background: #F5F5F5;
      transform: translate(-1px, -1px);
      box-shadow: 3px 3px 0px var(--border-color);
    }

    .filter-pill.active {
      background: #000000;
      color: #FFFFFF;
      box-shadow: 4px 4px 0px var(--border-color);
      transform: translate(-2px, -2px);
    }

    .providers-toolbar-right {
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .id-filter-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.65rem 1.25rem;
      background: var(--bg-card);
      border: 2px solid var(--border-color);
      color: #000000;
      border-radius: var(--radius-sm);
      font-size: 0.92rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      cursor: pointer;
      box-shadow: 2px 2px 0px var(--border-color);
      min-height: 48px;
      transition: var(--transition);
      user-select: none;
    }

    .id-filter-btn:hover {
      background: #F5F5F5;
      transform: translate(-1px, -1px);
      box-shadow: 3px 3px 0px var(--border-color);
    }

    .id-filter-btn.active {
      background: #000000;
      color: #FFFFFF;
      box-shadow: 4px 4px 0px var(--border-color);
      transform: translate(-2px, -2px);
    }

    .id-filter-btn .ifb-count {
      display: inline-block;
      font-size: 0.75rem;
      font-weight: 900;
      background: #000000;
      color: #FFFFFF;
      padding: 0.15rem 0.5rem;
      border-radius: 999px;
      line-height: 1.1;
    }

    .id-filter-btn.active .ifb-count {
      background: var(--bg-card);
      color: #000000;
    }

    .providers-count-text {
      font-size: 0.95rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #000000;
    }

    /* ==========================================================================
       PROVIDER CARDS (Neo-Brutalist 2px border + 4px 4px 0 #000 shadow)
       ========================================================================== */
    .providers-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.75rem;
    }

    .provider-card {
      background: var(--bg-card);
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 2rem 1.85rem;
      box-shadow: 4px 4px 0px var(--border-color);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: var(--transition);
    }

    .provider-card:hover {
      transform: translate(-3px, -3px);
      box-shadow: 7px 7px 0px var(--border-color);
    }

    .provider-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 1.15rem;
    }

    .provider-avatar {
      width: 52px;
      height: 52px;
      border-radius: var(--radius-sm);
      background: #000000;
      color: #FFFFFF;
      border: 2px solid var(--border-color);
      font-weight: 900;
      font-size: 1.45rem;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 2px 2px 0px var(--border-color);
      flex-shrink: 0;
    }

    .provider-name-box {
      flex: 1;
      min-width: 0;
    }

    .provider-name {
      font-size: 1.35rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: -0.02em;
      color: #000000;
      margin-bottom: 0.25rem;
    }

    .provider-meta {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.88rem;
      font-weight: 700;
      color: var(--gray-700);
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .provider-category-tag {
      background: #F5F5F5;
      border: 1px solid #000000;
      padding: 0.15rem 0.55rem;
      border-radius: var(--radius-sm);
    }

    .provider-rating-badge {
      background: #000000;
      color: #FFFFFF;
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 0.35rem 0.65rem;
      font-size: 0.95rem;
      font-weight: 900;
      letter-spacing: 0.02em;
      flex-shrink: 0;
    }

    /* Provider Badges: ID Verified (Black pill), others (white with black border) */
    .provider-badges-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
      margin: 0.85rem 0 1rem 0;
    }

    .provider-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      font-size: 0.76rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      padding: 0.25rem 0.65rem;
      border-radius: var(--radius-full);
      line-height: 1.25;
      border: 1.5px solid var(--border-color);
    }

    .provider-badge.badge-verified {
      background: #000000;
      color: #FFFFFF;
      border-color: #000000;
    }

    .provider-badge.badge-bg,
    .provider-badge.badge-rating,
    .provider-badge.badge-insured,
    .provider-badge.badge-kit,
    .provider-badge.badge-certified {
      background: var(--bg-card);
      color: var(--text-primary);
      border-color: var(--border-color);
    }

    [data-theme="dark"] .provider-badge.badge-bg,
    [data-theme="dark"] .provider-badge.badge-rating,
    [data-theme="dark"] .provider-badge.badge-insured,
    [data-theme="dark"] .provider-badge.badge-kit,
    [data-theme="dark"] .provider-badge.badge-certified {
      background: #111111;
      color: #FFFFFF;
      border-color: #FFFFFF;
    }

    /* ==========================================================================
       GENDER FILTER BAR & GENDER BADGE (Monochrome Neo-Brutalist)
       ========================================================================== */
    .gender-filter-bar {
      margin-top: 0.5rem;
      margin-bottom: 1.5rem;
      padding: 0.85rem 1.25rem;
      background: #F5F5F5;
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
      box-shadow: 3px 3px 0px var(--border-color);
      transition: all 0.2s ease;
    }

    [data-theme="dark"] .gender-filter-bar {
      background: #181818;
      border-color: #FFFFFF;
      box-shadow: 3px 3px 0px #FFFFFF;
    }

    .gender-filter-bar.highlighted {
      border: 2.5px solid var(--border-color);
      box-shadow: 4px 4px 0px var(--border-color);
    }

    [data-theme="dark"] .gender-filter-bar.highlighted {
      border-color: #FFFFFF;
      box-shadow: 4px 4px 0px #FFFFFF;
    }

    .gfb-label-group {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      flex-wrap: wrap;
    }

    .gfb-icon {
      font-size: 1.15rem;
    }

    .gfb-label {
      font-size: 0.92rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-primary);
    }

    .gfb-badge {
      font-size: 0.72rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      padding: 0.2rem 0.55rem;
      background: var(--bg-card);
      border: 1.5px solid var(--border-color);
      border-radius: var(--radius-full);
      color: var(--text-primary);
    }

    .gender-pills-group {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      background: var(--bg-card);
      padding: 0.3rem;
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      box-shadow: 2px 2px 0px var(--border-color);
    }

    [data-theme="dark"] .gender-pills-group {
      border-color: #FFFFFF;
      box-shadow: 2px 2px 0px #FFFFFF;
    }

    .gender-pill {
      background: transparent;
      border: 1.5px solid transparent;
      border-radius: var(--radius-sm);
      color: var(--text-primary);
      font-family: inherit;
      font-size: 0.85rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      padding: 0.45rem 0.95rem;
      cursor: pointer;
      transition: all 0.15s ease;
      min-height: 38px;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      white-space: nowrap;
      user-select: none;
    }

    .gender-pill:hover {
      background: #E5E5E5;
      color: #000000;
    }

    [data-theme="dark"] .gender-pill:hover {
      background: #333333;
      color: #FFFFFF;
    }

    .gender-pill.active {
      background: #000000 !important;
      color: #FFFFFF !important;
      border-color: var(--border-color) !important;
      box-shadow: 2px 2px 0px var(--border-color);
    }

    [data-theme="dark"] .gender-pill.active {
      background: #FFFFFF !important;
      color: #000000 !important;
      border-color: #FFFFFF !important;
      box-shadow: 2px 2px 0px #FFFFFF;
    }

    .provider-badge.badge-gender {
      background: var(--bg-card);
      color: var(--text-primary);
      border: 1.5px solid var(--border-color);
      font-weight: 800;
    }

    [data-theme="dark"] .provider-badge.badge-gender {
      background: #111111;
      color: #FFFFFF;
      border-color: #FFFFFF;
    }


    .provider-location-row {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--gray-700);
      margin-bottom: 0.85rem;
    }

    .provider-distance {
      color: #000000;
      font-weight: 800;
    }

    .provider-features-list {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
      margin-bottom: 1.5rem;
    }

    .provider-feature-tag {
      background: #F5F5F5;
      border: 1px solid #000000;
      border-radius: var(--radius-sm);
      padding: 0.25rem 0.65rem;
      font-size: 0.82rem;
      font-weight: 700;
      color: #000000;
    }

    .provider-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-top: 2px solid #000000;
      padding-top: 1.25rem;
      margin-top: auto;
    }

    .provider-price-box {
      display: flex;
      flex-direction: column;
    }

    .provider-price-label {
      font-size: 0.75rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--gray-500);
    }

    .provider-price-value {
      font-size: 1.45rem;
      font-weight: 900;
      letter-spacing: -0.02em;
      color: #000000;
    }

    .provider-actions {
      display: flex;
      align-items: center;
      gap: 0.65rem;
    }

    .btn-call {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 48px;
      height: 48px;
      border-radius: var(--radius-sm);
      border: 2px solid var(--border-color);
      background: var(--bg-card);
      color: #000000;
      font-size: 1.15rem;
      box-shadow: 2px 2px 0px var(--border-color);
      cursor: pointer;
      transition: var(--transition);
    }

    .btn-call:hover {
      background: #000000;
      color: #FFFFFF;
      transform: translate(-1px, -1px);
      box-shadow: 3px 3px 0px var(--border-color);
    }

    [data-theme="dark"] .btn-call {
      color: #FFFFFF;
      border-color: #FFFFFF;
    }

    [data-theme="dark"] .btn-call:hover {
      background: #FFFFFF;
      color: #000000;
      box-shadow: 3px 3px 0px #FFFFFF;
    }

    .btn-whatsapp {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 48px;
      height: 48px;
      border-radius: var(--radius-sm);
      border: 2px solid var(--border-color);
      background: var(--bg-card);
      color: var(--text-primary);
      font-size: 1.15rem;
      box-shadow: 2px 2px 0px var(--border-color);
      cursor: pointer;
      transition: var(--transition);
      text-decoration: none;
    }

    .btn-whatsapp:hover {
      background: #000000;
      color: #FFFFFF;
      transform: translate(-1px, -1px);
      box-shadow: 3px 3px 0px var(--border-color);
    }

    [data-theme="dark"] .btn-whatsapp {
      color: #FFFFFF;
      border-color: #FFFFFF;
    }

    [data-theme="dark"] .btn-whatsapp:hover {
      background: #FFFFFF;
      color: #000000;
      box-shadow: 3px 3px 0px #FFFFFF;
    }

    /* Sub-services selectable chips on provider cards */
    .provider-subservices-box {
      margin-top: 1rem;
      padding-top: 0.85rem;
      border-top: 2px dashed var(--border-color);
    }

    .subservices-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.5rem;
    }

    .subservices-title {
      font-size: 0.82rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-primary);
    }

    .subservices-hint {
      font-size: 0.72rem;
      font-weight: 600;
      color: #666666;
    }

    [data-theme="dark"] .subservices-hint {
      color: #AAAAAA;
    }

    .subservices-chips-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
    }

    .subservice-chip {
      background: var(--bg-card);
      color: var(--text-primary);
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 0.4rem 0.75rem;
      font-size: 0.82rem;
      font-weight: 700;
      font-family: inherit;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      box-shadow: 2px 2px 0px var(--border-color);
      transition: all 0.15s ease;
      user-select: none;
      min-height: 36px;
    }

    .subservice-chip:hover {
      background: #000000;
      color: #FFFFFF;
      transform: translate(-1px, -1px);
      box-shadow: 3px 3px 0px var(--border-color);
    }

    [data-theme="dark"] .subservice-chip:hover {
      background: #FFFFFF;
      color: #000000;
      box-shadow: 3px 3px 0px #FFFFFF;
    }

    .subservice-chip.selected {
      background: #000000 !important;
      color: #FFFFFF !important;
      border-color: var(--border-color) !important;
      box-shadow: 3px 3px 0px var(--border-color) !important;
      transform: translate(-1px, -1px);
    }

    [data-theme="dark"] .subservice-chip.selected {
      background: #FFFFFF !important;
      color: #000000 !important;
      border-color: #FFFFFF !important;
      box-shadow: 3px 3px 0px #FFFFFF !important;
    }

    .subservice-chip .chip-check {
      display: none;
      font-weight: 900;
    }

    .subservice-chip.selected .chip-check {
      display: inline-block;
    }

    /* ==========================================================================
       PERSONAL CHEF MONTHLY PLAN TOGGLE & START PLAN STYLES (Monochrome Neo-Brutalist)
       ========================================================================== */
    .chef-monthly-toggle-row {
      margin-top: 1rem;
      padding: 0.85rem 1rem;
      background: #F5F5F5;
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.85rem;
      flex-wrap: wrap;
      box-shadow: 2px 2px 0px var(--border-color);
      transition: all 0.2s ease;
    }

    [data-theme="dark"] .chef-monthly-toggle-row {
      background: #161616;
      border-color: #FFFFFF;
      box-shadow: 2px 2px 0px #FFFFFF;
    }

    .cmtr-info {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
      flex: 1 1 180px;
    }

    .cmtr-tag {
      font-size: 0.68rem;
      font-weight: 900;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #555555;
    }

    [data-theme="dark"] .cmtr-tag {
      color: #AAAAAA;
    }

    .cmtr-title {
      font-size: 0.92rem;
      font-weight: 800;
      color: var(--text-primary);
      line-height: 1.25;
    }

    .cmtr-desc {
      font-size: 0.78rem;
      font-weight: 700;
      color: #333333;
    }

    [data-theme="dark"] .cmtr-desc {
      color: #CCCCCC;
    }

    .chef-toggle-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      background: var(--bg-card);
      color: var(--text-primary);
      border: 2px solid var(--border-color);
      border-radius: var(--radius-full);
      padding: 0.45rem 0.9rem;
      font-family: inherit;
      font-size: 0.78rem;
      font-weight: 900;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      cursor: pointer;
      box-shadow: 2px 2px 0px var(--border-color);
      transition: all 0.15s ease;
      white-space: nowrap;
      user-select: none;
    }

    .chef-toggle-pill .ctp-indicator {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: #FFFFFF;
      border: 2px solid var(--border-color);
      transition: all 0.15s ease;
    }

    .chef-toggle-pill:hover {
      transform: translate(-1px, -1px);
      box-shadow: 3px 3px 0px var(--border-color);
    }

    .chef-toggle-pill.active {
      background: #000000 !important;
      color: #FFFFFF !important;
      border-color: var(--border-color) !important;
      box-shadow: 3px 3px 0px var(--border-color) !important;
    }

    .chef-toggle-pill.active .ctp-indicator {
      background: #FFFFFF !important;
      border-color: #000000 !important;
    }

    [data-theme="dark"] .chef-toggle-pill {
      border-color: #FFFFFF;
      box-shadow: 2px 2px 0px #FFFFFF;
    }

    [data-theme="dark"] .chef-toggle-pill.active {
      background: #FFFFFF !important;
      color: #000000 !important;
      border-color: #FFFFFF !important;
      box-shadow: 3px 3px 0px #FFFFFF !important;
    }

    [data-theme="dark"] .chef-toggle-pill.active .ctp-indicator {
      background: #000000 !important;
      border-color: #FFFFFF !important;
    }

    /* Price Subtext */
    .provider-price-sub {
      display: block;
      font-size: 0.75rem;
      font-weight: 700;
      color: #666666;
      margin-top: 0.2rem;
    }

    [data-theme="dark"] .provider-price-sub {
      color: #AAAAAA;
    }

    /* Start Plan Button (High-Contrast Bold Neo-Brutalist) */
    .btn-start-plan {
      background: #000000;
      color: #FFFFFF;
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 0.75rem 1.65rem;
      font-size: 0.95rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      cursor: pointer;
      min-height: 48px;
      box-shadow: 4px 4px 0px var(--border-color);
      transition: var(--transition);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.35rem;
      white-space: nowrap;
    }

    .btn-start-plan:hover {
      background: var(--bg-card);
      color: #000000;
      transform: translate(-2px, -2px);
      box-shadow: 6px 6px 0px var(--border-color);
    }

    [data-theme="dark"] .btn-start-plan {
      background: #FFFFFF;
      color: #000000;
      border-color: #FFFFFF;
      box-shadow: 4px 4px 0px #FFFFFF;
    }

    [data-theme="dark"] .btn-start-plan:hover {
      background: #000000;
      color: #FFFFFF;
      border-color: #FFFFFF;
      box-shadow: 6px 6px 0px #FFFFFF;
    }


    .btn-book {
      background: #000000;
      color: #FFFFFF;
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 0.75rem 1.65rem;
      font-size: 0.95rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      cursor: pointer;
      min-height: 48px;
      box-shadow: 3px 3px 0px var(--border-color);
      transition: var(--transition);
    }

    .btn-book:hover {
      background: var(--bg-card);
      color: #000000;
      transform: translate(-2px, -2px);
      box-shadow: 5px 5px 0px var(--border-color);
    }

    /* Empty state */
    .empty-state {
      grid-column: 1 / -1;
      text-align: center;
      padding: 4rem 2rem;
      background: #F5F5F5;
      border: 2px dashed #000000;
      border-radius: var(--radius-sm);
    }

    .empty-icon {
      font-size: 2.75rem;
      margin-bottom: 1rem;
    }

    .empty-title {
      font-size: 1.45rem;
      font-weight: 900;
      text-transform: uppercase;
      margin-bottom: 0.5rem;
    }

    .empty-desc {
      color: var(--gray-700);
      font-size: 1.1rem;
      max-width: 600px;
      margin: 0 auto 1.5rem auto;
    }

    /* Primary & Secondary Generic Buttons */
    .btn-primary {
      background: #000000;
      color: #FFFFFF;
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 0.85rem 1.85rem;
      font-size: 1rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      cursor: pointer;
      min-height: 48px;
      box-shadow: 3px 3px 0px var(--border-color);
      transition: var(--transition);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
    }

    .btn-primary:hover {
      background: var(--bg-card);
      color: #000000;
      transform: translate(-2px, -2px);
      box-shadow: 5px 5px 0px var(--border-color);
    }

    .btn-secondary {
      background: var(--bg-card);
      color: #000000;
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 0.85rem 1.85rem;
      font-size: 1rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      cursor: pointer;
      min-height: 48px;
      box-shadow: 2px 2px 0px var(--border-color);
      transition: var(--transition);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
    }

    .btn-secondary:hover {
      background: #000000;
      color: #FFFFFF;
      transform: translate(-2px, -2px);
      box-shadow: 4px 4px 0px var(--border-color);
    }

    /* ==========================================================================
       CAB BOOKING SECTION (Bold Monochrome Neo-Brutalist)
       ========================================================================== */
    .cab-booking-section {
      background: #FAFAFA;
      border-bottom: 3px solid var(--border-color);
      padding: 5rem 0;
    }

    .cab-container-card {
      background: var(--bg-card);
      border: 3px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 2.75rem 2.25rem;
      box-shadow: 6px 6px 0px var(--border-color);
    }

    .cab-header-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 2px solid #000000;
      padding-bottom: 1.5rem;
      margin-bottom: 2rem;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .cab-title-group {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .cab-icon-badge {
      width: 54px;
      height: 54px;
      background: #000000;
      color: #FFFFFF;
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.75rem;
      box-shadow: 2px 2px 0px var(--border-color);
    }

    .cab-main-title {
      font-size: 1.85rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: -0.02em;
    }

    .cab-main-subtitle {
      font-size: 0.95rem;
      color: var(--gray-700);
      font-weight: 600;
    }

    .btn-back-services {
      background: var(--bg-card);
      color: #000000;
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 0.55rem 1.15rem;
      font-size: 0.88rem;
      font-weight: 800;
      text-transform: uppercase;
      cursor: pointer;
      box-shadow: 2px 2px 0px var(--border-color);
      transition: var(--transition);
    }

    .btn-back-services:hover {
      background: #000000;
      color: #FFFFFF;
    }

    /* Ride Selector Options */
    .cab-ride-types-block {
      margin-bottom: 2rem;
    }

    .cab-input-label {
      display: block;
      font-size: 0.9rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #000000;
      margin-bottom: 0.65rem;
    }

    .cab-ride-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
    }

    .cab-ride-option {
      background: var(--bg-card);
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 1.25rem 1rem;
      cursor: pointer;
      box-shadow: 3px 3px 0px var(--border-color);
      transition: var(--transition);
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      min-height: 48px;
    }

    .cab-ride-option:hover {
      transform: translate(-2px, -2px);
      box-shadow: 5px 5px 0px var(--border-color);
    }

    /* Active ride inverted */
    .cab-ride-option.active {
      background: #000000;
      color: #FFFFFF;
      transform: translate(-2px, -2px);
      box-shadow: 5px 5px 0px var(--border-color);
    }

    .cab-ride-option.active .cro-name,
    .cab-ride-option.active .cro-rate,
    .cab-ride-option.active .cro-desc {
      color: #FFFFFF;
    }

    .cro-icon {
      font-size: 2.2rem;
      margin-bottom: 0.35rem;
      line-height: 1;
    }

    .cro-name {
      font-size: 1.15rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: -0.01em;
      color: #000000;
    }

    .cro-rate {
      font-size: 0.95rem;
      font-weight: 900;
      color: #000000;
      margin-top: 0.15rem;
    }

    .cro-desc {
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--gray-700);
      margin-top: 0.2rem;
    }

    /* Pickup & Drop Inputs */
    .cab-route-inputs {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
      margin-bottom: 1.75rem;
    }

    .cab-input-block {
      display: flex;
      flex-direction: column;
    }

    .cab-input-wrapper {
      position: relative;
      display: flex;
      align-items: center;
    }

    .cab-text-input {
      width: 100%;
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 0.85rem 1.15rem;
      font-size: 1.05rem;
      font-weight: 600;
      color: #000000;
      background: var(--bg-card);
      box-shadow: 2px 2px 0px var(--border-color);
      min-height: 48px;
    }

    .cab-text-input:focus {
      outline: none;
      box-shadow: 4px 4px 0px var(--border-color);
      transform: translate(-1px, -1px);
    }

    .cab-chip-suggestions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
      margin-top: 0.5rem;
      align-items: center;
    }

    .cab-chip-hint {
      font-size: 0.75rem;
      font-weight: 800;
      text-transform: uppercase;
      color: var(--gray-700);
    }

    .cab-loc-chip {
      background: var(--bg-card);
      border: 1px solid #000000;
      border-radius: var(--radius-sm);
      padding: 0.2rem 0.6rem;
      font-size: 0.78rem;
      font-weight: 800;
      text-transform: uppercase;
      cursor: pointer;
      color: #000000;
      box-shadow: 1px 1px 0px #000000;
    }

    .cab-loc-chip:hover {
      background: #000000;
      color: #FFFFFF;
    }

    /* Fare Card */
    .cab-fare-card {
      background: #F5F5F5;
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 1.75rem 1.5rem;
      box-shadow: 4px 4px 0px var(--border-color);
      margin-bottom: 2rem;
    }

    .cfc-main {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 1rem;
      margin-bottom: 0.75rem;
    }

    .cfc-fare-lbl {
      font-size: 0.85rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--gray-700);
    }

    .cfc-fare-amount {
      font-size: 2.25rem;
      font-weight: 900;
      letter-spacing: -0.03em;
      color: #000000;
    }

    .cfc-eta-pill {
      background: #000000;
      color: #FFFFFF;
      border: 2px solid var(--border-color);
      padding: 0.45rem 1rem;
      border-radius: var(--radius-sm);
      font-size: 0.95rem;
      font-weight: 900;
      text-transform: uppercase;
      box-shadow: 2px 2px 0px var(--border-color);
    }

    .cfc-footer-note {
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--gray-700);
      border-top: 1px solid #CCCCCC;
      padding-top: 0.65rem;
    }

    .cab-empty-prompt {
      text-align: center;
      padding: 1.75rem;
      background: #F5F5F5;
      border: 2px dashed #000000;
      border-radius: var(--radius-sm);
      font-weight: 700;
      color: var(--gray-700);
      margin-bottom: 2rem;
    }

    .btn-book-cab {
      width: 100%;
      background: #000000;
      color: #FFFFFF;
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 1rem 2rem;
      font-size: 1.25rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      cursor: pointer;
      box-shadow: 4px 4px 0px var(--border-color);
      min-height: 56px;
      transition: var(--transition);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.65rem;
    }

    .btn-book-cab:hover {
      background: var(--bg-card);
      color: #000000;
      transform: translate(-2px, -2px);
      box-shadow: 6px 6px 0px var(--border-color);
    }

    /* ==========================================================================
       TRIP IN PROGRESS SCREEN
       ========================================================================== */
    .tip-status-card {
      background: var(--bg-card);
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 1.75rem;
      box-shadow: 4px 4px 0px var(--border-color);
      margin-bottom: 1.75rem;
    }

    .tip-pulse-dot {
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: #000000;
      display: inline-block;
    }

    .tip-status-title {
      font-size: 1.55rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: -0.02em;
      color: #000000;
    }

    .tip-status-desc {
      font-size: 1rem;
      font-weight: 600;
      color: var(--gray-700);
      margin-top: 0.25rem;
    }

    /* Steps Progress Bar */
    .tip-steps-progress {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 1.75rem;
      position: relative;
    }

    .tip-step {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.4rem;
      z-index: 2;
    }

    .step-circle {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: var(--bg-card);
      border: 2px solid var(--border-color);
      color: #000000;
      font-weight: 900;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.95rem;
    }

    .tip-step.active .step-circle {
      background: #000000;
      color: #FFFFFF;
      box-shadow: 2px 2px 0px var(--border-color);
    }

    .tip-step.completed .step-circle {
      background: #000000;
      color: #FFFFFF;
    }

    .step-label {
      font-size: 0.78rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: #000000;
    }

    .tip-step-line {
      flex: 1;
      height: 3px;
      background: #E5E5E5;
      margin: 0 0.5rem 1.25rem 0.5rem;
    }

    .tip-step-line.filled {
      background: #000000;
    }

    /* OTP Container */
    .tip-otp-container {
      background: #F5F5F5;
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 1.5rem;
      text-align: center;
      box-shadow: 3px 3px 0px var(--border-color);
      margin-bottom: 1.75rem;
    }

    .otp-badge-title {
      font-size: 0.85rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #000000;
      margin-bottom: 0.5rem;
    }

    .otp-digits-display {
      font-family: 'Space Grotesk', monospace, sans-serif;
      font-size: 3rem;
      font-weight: 900;
      letter-spacing: 0.3em;
      color: #000000;
      line-height: 1;
      margin-bottom: 0.5rem;
    }

    .otp-subtext {
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--gray-700);
    }

    /* Driver Profile Card */
    .tip-driver-card {
      background: var(--bg-card);
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 1.75rem;
      box-shadow: 4px 4px 0px var(--border-color);
      margin-bottom: 1.75rem;
    }

    .tdc-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .tdc-avatar-box {
      width: 58px;
      height: 58px;
      background: #000000;
      color: #FFFFFF;
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      font-size: 2rem;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 2px 2px 0px var(--border-color);
    }

    .tdc-name {
      font-size: 1.35rem;
      font-weight: 900;
      text-transform: uppercase;
      color: #000000;
    }

    .tdc-rating {
      font-size: 0.9rem;
      font-weight: 800;
      color: #000000;
    }

    .tdc-car-model, .tdc-cab-number {
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--gray-700);
    }

    .btn-call-driver {
      background: #000000;
      color: #FFFFFF;
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 0.65rem 1.25rem;
      font-size: 0.92rem;
      font-weight: 900;
      text-transform: uppercase;
      cursor: pointer;
      box-shadow: 2px 2px 0px var(--border-color);
      transition: var(--transition);
      min-height: 48px;
      display: inline-flex;
      align-items: center;
    }

    .btn-call-driver:hover {
      background: var(--bg-card);
      color: #000000;
    }

    .btn-share-driver {
      background: var(--bg-card);
      color: #000000;
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 0.65rem 1.25rem;
      font-size: 0.92rem;
      font-weight: 900;
      text-transform: uppercase;
      cursor: pointer;
      box-shadow: 2px 2px 0px var(--border-color);
      transition: var(--transition);
      min-height: 48px;
    }

    .btn-share-driver:hover {
      background: #000000;
      color: #FFFFFF;
    }

    .tip-summary-card {
      background: #F5F5F5;
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 1.5rem;
      box-shadow: 3px 3px 0px var(--border-color);
      margin-bottom: 1.75rem;
    }

    .tsc-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.45rem 0;
      border-bottom: 1px solid #E5E5E5;
      font-size: 0.95rem;
    }

    .tsc-row:last-child {
      border-bottom: none;
    }

    .tsc-lbl {
      font-weight: 700;
      text-transform: uppercase;
      font-size: 0.85rem;
      color: var(--gray-700);
    }

    .tsc-val {
      font-weight: 900;
      color: #000000;
    }

    .tsc-fare-val {
      font-size: 1.45rem;
      color: #000000;
    }

    .tip-completed-banner {
      background: #000000;
      color: #FFFFFF;
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 1.75rem;
      text-align: center;
      box-shadow: 4px 4px 0px var(--border-color);
      margin-bottom: 1.75rem;
    }

    .tcb-title {
      font-size: 1.85rem;
      font-weight: 900;
      text-transform: uppercase;
      color: #FFFFFF;
      margin-bottom: 0.4rem;
    }

    .tcb-desc {
      color: #CCCCCC;
      font-size: 1.05rem;
    }

    /* ==========================================================================
       DRIVER RATING & REVIEWS STYLES (Monochrome)
       ========================================================================== */
    .tip-rating-card {
      background: var(--bg-card);
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 2rem;
      margin-bottom: 1.75rem;
      box-shadow: 4px 4px 0px var(--border-color);
    }

    .trc-eyebrow {
      font-size: 0.82rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #000000;
    }

    .trc-title {
      font-size: 1.55rem;
      font-weight: 900;
      text-transform: uppercase;
      margin: 0.35rem 0;
    }

    .trc-desc {
      font-size: 0.95rem;
      color: var(--gray-700);
    }

    .star-selector {
      display: flex;
      justify-content: center;
      gap: 0.65rem;
      margin: 1.25rem 0 0.5rem 0;
    }

    .star-btn {
      background: none;
      border: none;
      font-size: 2.8rem;
      color: #CCCCCC; /* Inactive star */
      cursor: pointer;
      line-height: 1;
      transition: var(--transition);
      padding: 0 0.2rem;
    }

    /* Active stars in black */
    .star-btn.active {
      color: #000000;
    }

    .star-btn:hover {
      transform: scale(1.15);
      color: #000000;
    }

    .star-rating-label {
      display: block;
      text-align: center;
      font-size: 1rem;
      font-weight: 900;
      text-transform: uppercase;
      color: #000000;
      margin-bottom: 1.5rem;
    }

    .quick-tags-list {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.65rem;
      margin-bottom: 1.5rem;
    }

    .quick-tag-btn {
      background: var(--bg-card);
      border: 2px solid var(--border-color);
      color: #000000;
      padding: 0.55rem 1.15rem;
      border-radius: var(--radius-sm);
      font-size: 0.88rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      cursor: pointer;
      box-shadow: 2px 2px 0px var(--border-color);
      transition: var(--transition);
      min-height: 48px;
    }

    .quick-tag-btn:hover {
      transform: translate(-1px, -1px);
      box-shadow: 3px 3px 0px var(--border-color);
    }

    /* Active quick tag inverted */
    .quick-tag-btn.active {
      background: #000000;
      color: #FFFFFF;
      transform: translate(-2px, -2px);
      box-shadow: 4px 4px 0px var(--border-color);
    }

    .trc-textarea {
      width: 100%;
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 0.85rem 1.15rem;
      font-size: 1rem;
      font-family: inherit;
      color: #000000;
      background: var(--bg-card);
      box-shadow: 2px 2px 0px var(--border-color);
      resize: vertical;
      min-height: 90px;
    }

    .trc-textarea:focus {
      outline: none;
      box-shadow: 4px 4px 0px var(--border-color);
      transform: translate(-1px, -1px);
    }

    .btn-submit-review {
      width: 100%;
      background: #000000;
      color: #FFFFFF;
      border: 2px solid var(--border-color);
      padding: 1rem 1.5rem;
      border-radius: var(--radius-sm);
      font-size: 1.1rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      cursor: pointer;
      box-shadow: 4px 4px 0px var(--border-color);
      min-height: 52px;
      transition: var(--transition);
    }

    .btn-submit-review:hover {
      background: var(--bg-card);
      color: #000000;
      transform: translate(-2px, -2px);
      box-shadow: 6px 6px 0px var(--border-color);
    }

    .tip-thankyou-card {
      background: #F5F5F5;
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 1.75rem;
      text-align: center;
      margin-bottom: 1.75rem;
      box-shadow: 4px 4px 0px var(--border-color);
    }

    .tyc-title {
      font-size: 1.55rem;
      font-weight: 900;
      text-transform: uppercase;
      color: #000000;
      margin-bottom: 0.35rem;
    }

    .tyc-desc {
      font-size: 1rem;
      color: var(--gray-700);
    }

    .driver-review-item {
      background: #F5F5F5;
      border: 1.5px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 0.85rem 1rem;
      margin-bottom: 0.65rem;
    }

    .dri-author {
      font-weight: 900;
      font-size: 0.95rem;
      color: #000000;
    }

    .dri-meta {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.85rem;
      font-weight: 800;
      color: #000000;
    }

    .dri-stars {
      color: #000000;
      font-weight: 900;
    }

    .dri-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
      margin: 0.35rem 0;
    }

    .dri-tag {
      background: var(--bg-card);
      border: 1px solid #000000;
      color: #000000;
      font-size: 0.75rem;
      font-weight: 800;
      text-transform: uppercase;
      padding: 0.15rem 0.55rem;
      border-radius: var(--radius-sm);
    }

    .dri-comment {
      font-size: 0.92rem;
      color: #000000;
      font-style: italic;
    }

    /* ==========================================================================
       MODALS & DIALOGS
       ========================================================================== */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.7);
      backdrop-filter: blur(4px);
      z-index: 1200;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.25rem;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease;
    }

    .modal-overlay.active {
      opacity: 1;
      pointer-events: auto;
    }

    .modal-dialog {
      background: var(--bg-card);
      border: 3px solid var(--border-color);
      border-radius: var(--radius-sm);
      box-shadow: 8px 8px 0px var(--border-color);
      width: 100%;
      max-width: 580px;
      max-height: 90vh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      animation: modalSlideUp 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @keyframes modalSlideUp {
      from { transform: translateY(15px) scale(0.97); }
      to { transform: translateY(0) scale(1); }
    }

    .modal-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1.35rem 1.75rem;
      border-bottom: 2px solid #000000;
      background: #F5F5F5;
    }

    .modal-title {
      font-size: 1.45rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: -0.02em;
    }

    .modal-subtitle {
      font-size: 0.9rem;
      color: var(--gray-700);
      font-weight: 600;
    }

    .modal-close-btn {
      background: var(--bg-card);
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      width: 40px;
      height: 40px;
      font-size: 1.45rem;
      font-weight: 900;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 2px 2px 0px var(--border-color);
      transition: var(--transition);
    }

    .modal-close-btn:hover {
      background: #000000;
      color: #FFFFFF;
    }

    .modal-body {
      padding: 1.75rem;
      overflow-y: auto;
    }

    .modal-footer {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 0.85rem;
      padding: 1.25rem 1.75rem;
      border-top: 2px solid #000000;
      background: #F5F5F5;
    }

    .form-group {
      margin-bottom: 1.35rem;
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }

    .form-label {
      display: block;
      font-size: 0.85rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #000000;
      margin-bottom: 0.4rem;
    }

    .form-input, .form-select, .form-textarea {
      width: 100%;
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 0.8rem 1rem;
      font-size: 1rem;
      font-weight: 600;
      color: #000000;
      background: var(--bg-card);
      box-shadow: 2px 2px 0px var(--border-color);
      min-height: 48px;
    }

    .form-input:focus, .form-select:focus, .form-textarea:focus {
      outline: none;
      box-shadow: 4px 4px 0px var(--border-color);
      transform: translate(-1px, -1px);
    }

    .field-error {
      font-size: 0.82rem;
      font-weight: 800;
      color: var(--sos-red);
      margin-top: 0.35rem;
      display: none;
    }

    /* Booking Confirmation Card */
    .booking-summary-card {
      background: #F5F5F5;
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 1.25rem 1.5rem;
      box-shadow: 3px 3px 0px var(--border-color);
      margin-bottom: 1.5rem;
    }

    /* My Bookings List */
    .booking-item-card {
      background: var(--bg-card);
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 1.35rem;
      box-shadow: 3px 3px 0px var(--border-color);
      margin-bottom: 1rem;
    }

    .bi-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1.5px solid #000000;
      padding-bottom: 0.65rem;
      margin-bottom: 0.85rem;
    }

    .bi-title {
      font-size: 1.25rem;
      font-weight: 900;
      text-transform: uppercase;
      color: #000000;
    }

    .bi-status {
      background: #000000;
      color: #FFFFFF;
      border-radius: 999px;
      font-size: 0.75rem;
      font-weight: 800;
      text-transform: uppercase;
      padding: 0.2rem 0.65rem;
    }

    /* ==========================================================================
       FOOTER (Solid Black with White Text)
       ========================================================================== */
    .site-footer {
      background: #000000;
      color: #FFFFFF;
      border-top: 3px solid #000000;
      padding: 4.5rem 0 3.5rem 0;
      text-align: center;
    }

    .site-footer .brand-title {
      color: #FFFFFF;
    }

    .site-footer .brand-title span {
      color: #FFFFFF;
      text-decoration-color: #FFFFFF;
    }

    .site-footer .brand-logo-icon {
      background: var(--bg-card);
      color: #000000;
      border-color: #FFFFFF;
    }

    .footer-desc {
      font-size: 1.1rem;
      font-weight: 500;
      color: #CCCCCC;
      max-width: 750px;
      margin: 1rem auto 1.75rem auto;
      line-height: 1.6;
    }

    .footer-pills {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin-bottom: 2rem;
    }

    .footer-pill {
      background: #111111;
      border: 1.5px solid #444444;
      color: #FFFFFF;
      padding: 0.4rem 1rem;
      border-radius: var(--radius-sm);
      font-size: 0.85rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .footer-copy {
      font-size: 0.85rem;
      color: #888888;
      border-top: 1px solid #222222;
      padding-top: 1.5rem;
      max-width: 600px;
      margin: 0 auto;
    }

    /* ==========================================================================
       THE ONLY COLOR EXCEPTION: EMERGENCY / SOS ELEMENTS IN RED (#E00000)
       ========================================================================== */
    .header-emergency-btn {
      position: fixed;
      top: 14px;
      right: 16px;
      z-index: 1050;
      background: var(--sos-red);
      color: #FFFFFF;
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 0.55rem 1.15rem;
      font-size: 0.95rem;
      font-weight: 900;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      box-shadow: 3px 3px 0px var(--border-color);
      animation: headerSosPulse 2s infinite ease-in-out;
      user-select: none;
      min-height: 48px;
    }

    .header-emergency-btn:hover {
      background: var(--sos-red-hover);
      transform: translate(-2px, -2px);
      box-shadow: 5px 5px 0px var(--border-color);
    }

    .header-emergency-btn.active {
      background: #000000;
      color: #FFFFFF;
      box-shadow: 4px 4px 0px var(--sos-red);
    }

    @keyframes headerSosPulse {
      0% { box-shadow: 3px 3px 0px #000000, 0 0 0 0 rgba(224, 0, 0, 0.6); }
      70% { box-shadow: 3px 3px 0px #000000, 0 0 0 10px rgba(224, 0, 0, 0); }
      100% { box-shadow: 3px 3px 0px #000000, 0 0 0 0 rgba(224, 0, 0, 0); }
    }

    .floating-sos-btn {
      position: fixed;
      bottom: 2rem;
      right: 2rem;
      z-index: 9999;
      background: var(--sos-red);
      color: #FFFFFF;
      border: 3px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 0.9rem 1.75rem;
      font-size: 1.25rem;
      font-weight: 900;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      cursor: pointer;
      box-shadow: 5px 5px 0px var(--border-color);
      display: none;
      align-items: center;
      gap: 0.5rem;
      min-height: 54px;
    }

    .floating-sos-btn:hover {
      background: var(--sos-red-hover);
      transform: translate(-2px, -2px);
      box-shadow: 7px 7px 0px var(--border-color);
    }

    /* Emergency Panel */
    .emergency-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.7);
      backdrop-filter: blur(4px);
      z-index: 1090;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s ease;
    }

    .emergency-backdrop.active {
      opacity: 1;
      pointer-events: auto;
    }

    .emergency-panel {
      position: fixed;
      top: 76px;
      right: 16px;
      width: 460px;
      max-width: calc(100vw - 32px);
      max-height: calc(100vh - 90px);
      background: var(--bg-card);
      border: 3px solid var(--border-color);
      border-radius: var(--radius-sm);
      box-shadow: 8px 8px 0px var(--border-color);
      z-index: 1100;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      opacity: 0;
      pointer-events: none;
      transform: translateY(-10px) scale(0.97);
      transition: opacity 0.2s ease, transform 0.2s ease;
    }

    .emergency-panel.active {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0) scale(1);
    }

    .sheet-pull-handle {
      display: none;
    }

    .ep-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1.25rem 1.5rem;
      background: var(--bg-card);
      border-bottom: 2px solid #000000;
    }

    .ep-badge-icon {
      width: 42px;
      height: 42px;
      background: var(--sos-red);
      color: #FFFFFF;
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.35rem;
      box-shadow: 2px 2px 0px var(--border-color);
      flex-shrink: 0;
    }

    .ep-title {
      font-size: 1.25rem;
      font-weight: 900;
      text-transform: uppercase;
      color: #000000;
      margin: 0;
    }

    .ep-subtitle {
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--gray-700);
      margin: 0.15rem 0 0 0;
    }

    .ep-close-btn {
      background: var(--bg-card);
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      width: 38px;
      height: 38px;
      font-size: 1.5rem;
      font-weight: 900;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 2px 2px 0px var(--border-color);
      transition: var(--transition);
    }

    .ep-close-btn:hover {
      background: #000000;
      color: #FFFFFF;
    }

    .ep-content {
      padding: 1.25rem 1.5rem 1.75rem 1.5rem;
      overflow-y: auto;
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 1.35rem;
    }

    .btn-send-emergency-alert {
      width: 100%;
      background: var(--sos-red);
      color: #FFFFFF;
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 0.95rem 1.15rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      cursor: pointer;
      box-shadow: 4px 4px 0px var(--border-color);
      min-height: 52px;
      transition: var(--transition);
      text-align: left;
    }

    .btn-send-emergency-alert:hover {
      background: var(--sos-red-hover);
      transform: translate(-2px, -2px);
      box-shadow: 6px 6px 0px var(--border-color);
    }

    .bsea-title {
      font-size: 1.05rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: -0.01em;
      color: #FFFFFF;
    }

    .bsea-sub {
      font-size: 0.78rem;
      color: #FEE2E2;
      font-weight: 600;
    }

    .bsea-badge {
      background: #000000;
      color: #FFFFFF;
      border: 1px solid #FFFFFF;
      font-size: 0.75rem;
      font-weight: 900;
      padding: 0.2rem 0.6rem;
      border-radius: var(--radius-sm);
    }

    /* Emergency Helplines Cards */
    .ep-helpline-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
    }

    .ep-helpline-card {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.65rem;
      padding: 0.85rem 1rem;
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      background: var(--bg-card);
      color: #000000;
      text-decoration: none;
      min-height: 54px;
      box-shadow: 3px 3px 0px var(--border-color);
      transition: var(--transition);
    }

    .ep-helpline-card:hover {
      background: #000000;
      color: #FFFFFF;
      transform: translate(-2px, -2px);
      box-shadow: 5px 5px 0px var(--border-color);
    }

    .ep-helpline-card:hover .ehc-name,
    .ep-helpline-card:hover .ehc-sub {
      color: #FFFFFF;
    }

    .ep-helpline-card:hover .ehc-number-badge {
      background: var(--bg-card);
      color: #000000;
    }

    .ehc-name {
      font-size: 0.92rem;
      font-weight: 900;
      text-transform: uppercase;
      color: #000000;
    }

    .ehc-sub {
      font-size: 0.72rem;
      font-weight: 600;
      color: var(--gray-700);
    }

    .ehc-number-badge {
      font-family: 'Space Grotesk', monospace, sans-serif;
      font-size: 1.15rem;
      font-weight: 900;
      background: #000000;
      color: #FFFFFF;
      border: 1px solid #000000;
      padding: 0.2rem 0.55rem;
      border-radius: var(--radius-sm);
    }

    /* Unified Emergency 112 highlighted */
    .card-unified {
      border: 2.5px solid var(--sos-red);
    }

    .card-unified .ehc-number-badge {
      background: var(--sos-red);
      color: #FFFFFF;
      border-color: var(--sos-red);
    }

    /* Contacts in panel */
    .ep-contact-item {
      background: #F5F5F5;
      border: 1.5px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 0.75rem 0.95rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      box-shadow: 2px 2px 0px var(--border-color);
      margin-bottom: 0.65rem;
    }

    .ep-contact-name {
      font-size: 0.92rem;
      font-weight: 900;
      text-transform: uppercase;
      color: #000000;
    }

    .ep-contact-phone {
      font-size: 0.82rem;
      font-weight: 700;
      font-family: monospace;
      color: var(--gray-700);
    }

    .ec-btn-call, .ec-btn-wa {
      background: #000000;
      color: #FFFFFF;
      border: 1.5px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 0.45rem 0.75rem;
      font-size: 0.8rem;
      font-weight: 900;
      text-transform: uppercase;
      box-shadow: 1px 1px 0px #000000;
      min-height: 40px;
      display: inline-flex;
      align-items: center;
    }

    .ec-btn-call:hover, .ec-btn-wa:hover {
      background: var(--bg-card);
      color: #000000;
    }

    /* Location Sharing in Panel */
    .btn-share-location {
      width: 100%;
      background: #000000;
      color: #FFFFFF;
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 0.85rem 1.15rem;
      font-size: 0.95rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      cursor: pointer;
      box-shadow: 3px 3px 0px var(--border-color);
      min-height: 48px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      transition: var(--transition);
    }

    .btn-share-location:hover {
      background: var(--bg-card);
      color: #000000;
      transform: translate(-2px, -2px);
      box-shadow: 5px 5px 0px var(--border-color);
    }

    /* Simulated Alert Modal & Countdown Screen */
    .ea-modal-dialog {
      max-width: 520px;
      background: var(--bg-card);
      border: 3px solid var(--border-color);
      border-radius: var(--radius-sm);
      box-shadow: 8px 8px 0px var(--border-color);
      overflow: hidden;
    }

    .ea-confirm-box {
      padding: 2.25rem 2rem;
      text-align: center;
    }

    .ea-confirm-icon-wrap {
      width: 72px;
      height: 72px;
      border-radius: var(--radius-sm);
      background: var(--sos-red);
      color: #FFFFFF;
      border: 2px solid var(--border-color);
      font-size: 2.25rem;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1.25rem auto;
      box-shadow: 4px 4px 0px var(--border-color);
    }

    .ea-confirm-title {
      font-size: 1.65rem;
      font-weight: 900;
      text-transform: uppercase;
      color: #000000;
      margin-bottom: 0.5rem;
    }

    .ea-confirm-desc {
      font-size: 1rem;
      font-weight: 500;
      color: var(--gray-700);
      margin-bottom: 1.5rem;
      line-height: 1.5;
    }

    .ea-recipients-card {
      background: #F5F5F5;
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 1rem 1.25rem;
      text-align: left;
      margin-bottom: 1.5rem;
      box-shadow: 3px 3px 0px var(--border-color);
    }

    .btn-ea-confirm {
      background: var(--sos-red);
      color: #FFFFFF;
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 0.85rem 1.5rem;
      font-size: 1rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      cursor: pointer;
      box-shadow: 3px 3px 0px var(--border-color);
      min-height: 48px;
    }

    .btn-ea-confirm:hover {
      background: var(--sos-red-hover);
      transform: translate(-2px, -2px);
      box-shadow: 5px 5px 0px var(--border-color);
    }

    .btn-ea-cancel {
      background: var(--bg-card);
      color: #000000;
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 0.85rem 1.5rem;
      font-size: 1rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      cursor: pointer;
      box-shadow: 2px 2px 0px var(--border-color);
      min-height: 48px;
    }

    .btn-ea-cancel:hover {
      background: #000000;
      color: #FFFFFF;
    }

    .ea-active-box {
      padding: 2.25rem 2rem;
      text-align: center;
    }

    .ea-active-header {
      background: #000000;
      color: #FFFFFF;
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 1.5rem;
      margin-bottom: 1.5rem;
      box-shadow: 4px 4px 0px var(--border-color);
    }

    .ea-active-title {
      font-size: 1.45rem;
      font-weight: 900;
      text-transform: uppercase;
      color: #FFFFFF;
      margin-bottom: 0.35rem;
      line-height: 1.2;
    }

    .ea-active-subtitle {
      font-size: 0.9rem;
      font-weight: 700;
      color: #E5E5E5;
    }

    .ea-countdown-card {
      background: var(--bg-card);
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 1.25rem;
      margin-bottom: 1.5rem;
      box-shadow: 4px 4px 0px var(--border-color);
    }

    .ea-countdown-digits {
      font-family: 'Space Grotesk', monospace, sans-serif;
      font-size: 2.75rem;
      font-weight: 900;
      color: var(--sos-red); /* Alert countdown in red */
      line-height: 1;
      display: block;
      margin: 0.35rem 0;
    }

    .btn-ea-cancel-alert {
      width: 100%;
      background: #000000;
      color: #FFFFFF;
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 1rem 1.5rem;
      font-size: 1.15rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      cursor: pointer;
      box-shadow: 4px 4px 0px var(--border-color);
      min-height: 52px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      transition: var(--transition);
    }

    .btn-ea-cancel-alert:hover {
      background: var(--bg-card);
      color: #000000;
      transform: translate(-2px, -2px);
      box-shadow: 6px 6px 0px var(--border-color);
    }

    /* ==========================================================================
       RESPONSIVE BREAKPOINTS (Laptop down to 360px Mobile)
       ========================================================================== */
    @media (max-width: 992px) {
      .services-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .providers-grid {
        grid-template-columns: 1fr;
      }
      .cab-ride-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 640px) {
      .hero-title {
        font-size: 2.4rem;
      }
      .services-grid {
        grid-template-columns: 1fr;
      }
      .form-row, .cab-route-inputs {
        grid-template-columns: 1fr;
      }
      .nav-link {
        display: none;
      }
      .city-badge {
        display: none !important;
      }
      .btn-cab-nav span, .btn-bookings span:first-child {
        display: none;
      }
      .btn-cab-nav, 
    /* Theme Toggle Button */
    .btn-theme-toggle {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      background: var(--btn-secondary-bg);
      border: 2px solid var(--border-color);
      color: var(--btn-secondary-text);
      border-radius: var(--radius-sm);
      padding: 0.65rem 1.15rem;
      font-size: 0.92rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      cursor: pointer;
      min-height: 48px;
      box-shadow: 3px 3px 0px var(--border-color);
      transition: var(--transition);
      user-select: none;
    }

    .btn-theme-toggle:hover {
      background: var(--btn-secondary-hover-bg);
      color: var(--btn-secondary-hover-text);
      transform: translate(-2px, -2px);
      box-shadow: 5px 5px 0px var(--border-color);
    }

    .btn-bookings {
        padding: 0.5rem 0.75rem;
      }
      .nav-inner {
        padding-right: 75px;
      }
      .header-emergency-btn {
        top: 15px;
        right: 10px;
        padding: 0.45rem 0.75rem;
        font-size: 0.82rem;
      }
      .search-bar {
        padding: 0.35rem 0.5rem 0.35rem 1rem;
      }
      .search-btn {
        padding: 0.65rem 1.15rem;
        font-size: 0.88rem;
      }
      .emergency-panel {
        top: auto;
        bottom: 0;
        left: 0;
        right: 0;
        width: 100%;
        max-width: 100%;
        max-height: 85vh;
        border-radius: 16px 16px 0 0;
        border-bottom: none;
        box-shadow: 0 -8px 0px #000000;
        transform: translateY(100%);
      }
      .emergency-panel.active {
        transform: translateY(0);
      }
      .sheet-pull-handle {
        display: block;
        width: 48px;
        height: 6px;
        background: #000000;
        border-radius: 999px;
        margin: 0.75rem auto 0 auto;
      }
      .ep-helpline-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
  <script>
    (function() {
      try {
        var savedTheme = localStorage.getItem('zenserve_theme') || 'light';
        document.documentElement.setAttribute('data-theme', savedTheme);
      } catch (e) {}
    })();
  </script>
</head>
<body>

  <!-- =====================================================================
       1. TOP NAVIGATION
       ===================================================================== -->
  <header class="site-header">
  <!-- GLOBAL FIXED QUICK-ACCESS EMERGENCY SOS BUTTON (Top-Right Corner) -->
  <button 
    type="button" 
    id="headerEmergencyBtn" 
    class="header-emergency-btn" 
    onclick="toggleEmergencyPanel()" 
    aria-label="Quick Access Emergency SOS" 
    aria-expanded="false"
    aria-controls="emergencyPanel"
  >
    <span class="heb-icon">🚨</span>
    <span class="heb-text">SOS</span>
  </button>

    <div class="container nav-inner">
      <div class="brand-group" id="brandHomeTrigger">
        <div class="brand-logo-icon">🏠</div>
        <div class="brand-title-box">
          <div class="brand-title">Zen<span>serve</span></div>
          <span class="city-badge">📍 Mohali &amp; Chandigarh</span>
        </div>
      </div>

      <nav class="nav-actions">
        <a href="#servicesSection" class="nav-link">Services</a>
        <a href="#providersSection" class="nav-link">Find Providers</a>
        <button type="button" id="navCabBtn" class="btn-cab-nav" onclick="openCabBookingSection()">
          <span>🚖 Book a Cab</span>
        </button>
        <button type="button" id="navMyBookingsBtn" class="btn-bookings" aria-label="View My Bookings">
          <span>📅 My Bookings</span>
          <span class="booking-counter-pill" id="bookingNavCount">1</span>
        </button>
        <button type="button" id="themeToggleBtn" class="btn-theme-toggle" onclick="toggleTheme()" aria-label="Toggle Light and Dark Mode" title="Switch Theme">
          <span class="tt-icon" id="themeToggleIcon">🌙</span>
          <span class="tt-text" id="themeToggleText">Dark</span>
        </button>
      </nav>
    </div>
  </header>

  <!-- =====================================================================
       THIN SCROLLING BLACK STRIP (PAUSES ON HOVER)
       ===================================================================== -->
  <div class="marquee-strip" aria-label="Services Ticker" title="Scrolling ticker (hover to pause)">
    <div class="marquee-track">
      <span class="marquee-content">
        PLUMBER &bull; ELECTRICIAN &bull; CAB &bull; PERSONAL CHEF &bull; BARBER &bull; MASSAGE THERAPY &bull; PAINTER &bull; LABOUR &bull; EMERGENCY &bull;&nbsp;
        PLUMBER &bull; ELECTRICIAN &bull; CAB &bull; PERSONAL CHEF &bull; BARBER &bull; MASSAGE THERAPY &bull; PAINTER &bull; LABOUR &bull; EMERGENCY &bull;&nbsp;
        PLUMBER &bull; ELECTRICIAN &bull; CAB &bull; PERSONAL CHEF &bull; BARBER &bull; MASSAGE THERAPY &bull; PAINTER &bull; LABOUR &bull; EMERGENCY &bull;&nbsp;
        PLUMBER &bull; ELECTRICIAN &bull; CAB &bull; PERSONAL CHEF &bull; BARBER &bull; MASSAGE THERAPY &bull; PAINTER &bull; LABOUR &bull; EMERGENCY &bull;&nbsp;
      </span>
      <span class="marquee-content" aria-hidden="true">
        PLUMBER &bull; ELECTRICIAN &bull; CAB &bull; PERSONAL CHEF &bull; BARBER &bull; MASSAGE THERAPY &bull; PAINTER &bull; LABOUR &bull; EMERGENCY &bull;&nbsp;
        PLUMBER &bull; ELECTRICIAN &bull; CAB &bull; PERSONAL CHEF &bull; BARBER &bull; MASSAGE THERAPY &bull; PAINTER &bull; LABOUR &bull; EMERGENCY &bull;&nbsp;
        PLUMBER &bull; ELECTRICIAN &bull; CAB &bull; PERSONAL CHEF &bull; BARBER &bull; MASSAGE THERAPY &bull; PAINTER &bull; LABOUR &bull; EMERGENCY &bull;&nbsp;
        PLUMBER &bull; ELECTRICIAN &bull; CAB &bull; PERSONAL CHEF &bull; BARBER &bull; MASSAGE THERAPY &bull; PAINTER &bull; LABOUR &bull; EMERGENCY &bull;&nbsp;
      </span>
    </div>
  </div>


  <!-- =====================================================================
       2. HERO SECTION
       ===================================================================== -->
  <section class="hero-section">
    <div class="container">
      <div class="hero-pill">
        <span>⚡ Verified Local Experts Across Tricity</span>
      </div>
      
      <h1 class="hero-title">
        Trusted Home &amp; Local Services across <span>Mohali &amp; Chandigarh</span>
      </h1>
      
      <p class="hero-subtitle">
        One tap to book certified AC repair technicians, plumbers, electricians, home cleaners, cabs, and home blood tests. Zero middlemen, direct transparency.
      </p>

      <!-- Real-Time Search Bar -->
      <div class="search-bar-wrapper">
        <form id="searchForm" class="search-bar" onsubmit="event.preventDefault(); handleSearchSubmit();">
          <span class="search-icon">🔍</span>
          <input 
            type="text" 
            id="searchInput" 
            class="search-input" 
            placeholder="Search for plumber, electrician, cab, AC repair, Sector 35, Phase 7..."
            autocomplete="off"
          >
          <button type="submit" class="search-btn">Find Help</button>
        </form>
      </div>

      <!-- Quick Chips -->
      <div class="hero-chips">
        <span class="chip-label">Popular in Mohali/Chandigarh:</span>
        <button type="button" class="quick-chip" data-search="AC Repair">❄️ AC Repair</button>
        <button type="button" class="quick-chip" data-search="Plumber">🔧 Plumber</button>
        <button type="button" class="quick-chip" data-search="Personal Chef">👨‍🍳 Personal Chef</button>
        <button type="button" class="quick-chip" data-search="Barber at Home">✂️ Barber at Home</button>
        <button type="button" class="quick-chip" data-search="Painter">🎨 Painter</button>
        <button type="button" class="quick-chip" data-search="Labour Work">👷 Labour Work</button>
        <button type="button" class="quick-chip" data-search="Massage Therapy">💆‍♂️ Massage Therapy</button>
        <button type="button" class="quick-chip" data-search="Cab" onclick="openCabBookingSection()">🚖 Cab</button>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       3. SIX SERVICE CARDS SECTION
       ===================================================================== -->
  <section class="section-wrap" id="servicesSection">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Our Core Offerings</span>
        <h2 class="section-title">All-in-One Home Services</h2>
        <p class="section-desc">Selected high-demand services built specifically for households in Mohali and Chandigarh.</p>
      </div>

      <div class="services-grid" id="servicesContainer">
        <!-- Rendered dynamically from GET /api/services -->
      </div>
    </div>
  </section>

  <!-- =====================================================================
       3.1 CAB BOOKING SECTION (Simulated)
       ===================================================================== -->
  <section class="section-wrap cab-booking-section" id="cabBookingSection" style="display: none;">
    <div class="container">
      <div class="cab-header-bar">
        <button type="button" class="btn-back-services" id="btnBackToServices" onclick="closeCabBookingSection()">
          &larr; Back to Services
        </button>
        <div class="cab-badge-pill">⚡ Instant Ride • Mohali &amp; Chandigarh</div>
      </div>

      <div class="cab-container-card">
        
        <!-- ==================== VIEW 1: BOOKING FORM ==================== -->
        <div id="cabBookingFormView" class="cab-view">
          <div class="cab-title-group">
            <div class="cab-icon-badge">🚖</div>
            <div>
              <h2 class="cab-main-title">Book a Cab in Seconds</h2>
              <p class="cab-main-subtitle">Zero surge pricing &bull; Direct driver connection &bull; Cash or UPI after trip</p>
            </div>
          </div>

          <!-- Pickup & Drop Locations -->
          <div class="cab-route-inputs">
            <!-- Pickup -->
            <div class="cab-input-block">
              <label class="cab-input-label" for="cabPickupInput">
                <span class="pin-dot pickup-dot"></span>
                <span>Pickup Location</span>
              </label>
              <div class="cab-input-wrapper">
                <input 
                  type="text" 
                  id="cabPickupInput" 
                  class="cab-text-input" 
                  placeholder="Enter pickup point (e.g. Phase 7, Mohali or Sector 35)"
                  autocomplete="off"
                >
                <button type="button" class="btn-cab-curr-loc" id="btnUseCurrentCabLocation" title="Use current location">
                  📍 Current Loc
                </button>
              </div>
              <div class="cab-chip-suggestions">
                <span class="cab-chip-hint">Popular:</span>
                <button type="button" class="cab-loc-chip" data-target="cabPickupInput" data-val="Phase 7, Mohali">Phase 7 Mohali</button>
                <button type="button" class="cab-loc-chip" data-target="cabPickupInput" data-val="Sector 35-C, Chandigarh">Sector 35-C Chd</button>
                <button type="button" class="cab-loc-chip" data-target="cabPickupInput" data-val="Phase 3B2, Mohali">Phase 3B2 Mohali</button>
                <button type="button" class="cab-loc-chip" data-target="cabPickupInput" data-val="Sector 17 Plaza, Chandigarh">Sector 17 Chd</button>
              </div>
            </div>

            <!-- Route Connector Icon -->
            <div class="cab-route-divider">
              <span class="route-line"></span>
              <span class="route-arrow">&darr;</span>
            </div>

            <!-- Drop -->
            <div class="cab-input-block">
              <label class="cab-input-label" for="cabDropInput">
                <span class="pin-dot drop-dot"></span>
                <span>Drop Location</span>
              </label>
              <div class="cab-input-wrapper">
                <input 
                  type="text" 
                  id="cabDropInput" 
                  class="cab-text-input" 
                  placeholder="Enter drop destination (e.g. Chandigarh Airport or Elante Mall)"
                  autocomplete="off"
                >
              </div>
              <div class="cab-chip-suggestions">
                <span class="cab-chip-hint">Popular:</span>
                <button type="button" class="cab-loc-chip" data-target="cabDropInput" data-val="Chandigarh Int'l Airport (IXC)">Chd Airport (IXC)</button>
                <button type="button" class="cab-loc-chip" data-target="cabDropInput" data-val="Elante Mall, Industrial Area Phase 1">Elante Mall</button>
                <button type="button" class="cab-loc-chip" data-target="cabDropInput" data-val="Mohali Railway Station, Sector 64">Mohali Station</button>
                <button type="button" class="cab-loc-chip" data-target="cabDropInput" data-val="ISBT Sector 43, Chandigarh">ISBT 43 Chd</button>
              </div>
            </div>
          </div>

          <!-- Ride Type Selector -->
          <div class="cab-ride-types-block">
            <label class="cab-section-heading">Select Ride Type</label>
            <div class="cab-ride-grid" id="cabRideTypesGrid">
              
              <!-- Bike -->
              <div class="cab-ride-option" data-ride-type="bike" data-rate="7" data-base="25" data-name="Bike" data-icon="🏍️">
                <div class="cro-top">
                  <div class="cro-icon">🏍️</div>
                  <span class="cro-rate-badge">₹7/km</span>
                </div>
                <div class="cro-title-row">
                  <span class="cro-title">Bike</span>
                  <span class="cro-cap">👤 1</span>
                </div>
                <p class="cro-desc">Fastest solo ride through city traffic</p>
              </div>

              <!-- Auto -->
              <div class="cab-ride-option" data-ride-type="auto" data-rate="11" data-base="35" data-name="Auto" data-icon="🛺">
                <div class="cro-top">
                  <div class="cro-icon">🛺</div>
                  <span class="cro-rate-badge">₹11/km</span>
                </div>
                <div class="cro-title-row">
                  <span class="cro-title">Auto</span>
                  <span class="cro-cap">👥 3</span>
                </div>
                <p class="cro-desc">Affordable, breezy local tricity commute</p>
              </div>

              <!-- Mini -->
              <div class="cab-ride-option active" data-ride-type="mini" data-rate="15" data-base="50" data-name="Mini" data-icon="🚗">
                <div class="cro-top">
                  <div class="cro-icon">🚗</div>
                  <span class="cro-rate-badge">₹15/km</span>
                </div>
                <div class="cro-title-row">
                  <span class="cro-title">Mini</span>
                  <span class="cro-cap">👥 4</span>
                </div>
                <p class="cro-desc">Compact comfortable AC hatchback</p>
              </div>

              <!-- Sedan -->
              <div class="cab-ride-option" data-ride-type="sedan" data-rate="19" data-base="70" data-name="Sedan" data-icon="🚘">
                <div class="cro-top">
                  <div class="cro-icon">🚘</div>
                  <span class="cro-rate-badge">₹19/km</span>
                </div>
                <div class="cro-title-row">
                  <span class="cro-title">Sedan</span>
                  <span class="cro-cap">👥 4</span>
                </div>
                <p class="cro-desc">Spacious top-rated premium sedans</p>
              </div>

            </div>
          </div>

          <!-- Fare Estimate & ETA Box -->
          <div class="cab-fare-card" id="cabFareEstimateBox" style="display: none;">
            <div class="cfc-main">
              <div class="cfc-fare-block">
                <span class="cfc-fare-lbl">Estimated Fare</span>
                <div class="cfc-fare-amount" id="cabEstFareVal">₹152</div>
                <span class="cfc-payment-note">Cash / UPI directly to driver</span>
              </div>
              <div class="cfc-eta-block">
                <div class="cfc-eta-pill" id="cabEstEtaVal">⚡ Driver arriving in 3 mins</div>
                <div class="cfc-route-info" id="cabRouteInfoVal">Distance: ~6.8 km &bull; Est. travel: ~16 mins</div>
              </div>
            </div>
            <div class="cfc-footer-note">
              <span>🛡️ Zero cancellation fee before arrival</span>
              <span>🔒 4-digit verified start OTP</span>
            </div>
          </div>

          <!-- Helper Prompt if locations are not yet entered -->
          <div class="cab-empty-prompt" id="cabEmptyLocationsPrompt">
            <span>💡 Enter both pickup and drop locations above to view your instant fare estimate and driver ETA.</span>
          </div>

          <!-- Form Error Notice -->
          <div class="cab-form-error" id="cabFormError"></div>

          <!-- Submit Button -->
          <div class="cab-action-bar">
            <button type="button" class="btn-book-cab" id="btnSubmitBookCab" onclick="handleBookCabSubmit()">
              <span id="btnBookCabText">🚖 Book Cab</span>
            </button>
          </div>
        </div>

        <!-- ==================== VIEW 2: TRIP IN PROGRESS ==================== -->
        <div id="cabTripProgressView" class="cab-view" style="display: none;">
          
          <!-- Live Status Bar -->
          <div class="tip-status-header">
            <div class="tip-live-indicator">
              <span class="tip-pulse-dot" id="tipPulseDot"></span>
              <span class="tip-status-text" id="tipStatusTitle">Driver on the way</span>
            </div>
            <div class="tip-status-desc" id="tipStatusDesc">Driver is heading towards your pickup location (ETA ~3 mins)</div>
          </div>

          <!-- Status Stepper Indicator -->
          <div class="tip-stepper">
            <div class="tip-step active" id="step-0">
              <div class="step-circle">1</div>
              <span class="step-label">Driver on the way</span>
            </div>
            <div class="tip-step-line" id="line-0"></div>
            <div class="tip-step" id="step-1">
              <div class="step-circle">2</div>
              <span class="step-label">Driver arrived</span>
            </div>
            <div class="tip-step-line" id="line-1"></div>
            <div class="tip-step" id="step-2">
              <div class="step-circle">3</div>
              <span class="step-label">Trip started</span>
            </div>
            <div class="tip-step-line" id="line-2"></div>
            <div class="tip-step" id="step-3">
              <div class="step-circle">4</div>
              <span class="step-label">Trip completed</span>
            </div>
          </div>

          <!-- OTP Box -->
          <div class="tip-otp-container" id="tipOtpCard">
            <div class="otp-badge-title">SHARE WITH DRIVER TO START TRIP</div>
            <div class="otp-digits-display" id="tipOtpDisplay">4 8 2 9</div>
            <div class="otp-subtext">Do not share OTP until the driver arrives at your pickup point</div>
          </div>

          <!-- Driver Card -->
          <div class="tip-driver-card">
            <div class="tdc-top">
              <div class="tdc-avatar-box">
                <div class="tdc-avatar" id="tipDriverAvatar">👨‍✈️</div>
                <div class="tdc-verified-badge" title="Verified Driver">✓</div>
              </div>
              <div class="tdc-info">
                <div class="tdc-name-row">
                  <h4 class="tdc-name" id="tipDriverName">Gurpreet Singh</h4>
                  <span class="tdc-rating" id="tipDriverRating">★ 4.9 (420+ trips)</span>
                </div>
                <div class="tdc-car-model" id="tipCarModel">White Maruti Swift Dzire</div>
                <div class="tdc-cab-number" id="tipCabNumber">CH 01 CB 4819</div>
              </div>
              <div class="tdc-call-col" style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                <a href="tel:+919815099887" class="btn-call-driver" id="tipDriverPhoneBtn">
                  <span>📞 Call</span>
                </a>
                <button type="button" class="btn-share-driver" id="tipDriverShareBtn" onclick="openShareTripModal()" title="Share trip details">
                  <span>🔗 Share</span>
                </button>
              </div>
            </div>

            <!-- Driver Reviews Panel inside Profile Card -->
            <div class="driver-reviews-panel" id="driverReviewsPanel" style="display: none; border-top: 1px solid var(--border-light); margin-top: 1rem; padding-top: 0.85rem;">
              <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.65rem;">
                <span style="font-size: 0.82rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">
                  Latest Passenger Reviews (3)
                </span>
                <span class="driver-avg-score" id="driverAvgScorePill" style="font-size: 0.82rem; font-weight: 800; color: #000000; background: #E5E5E5; border: 1.5px solid var(--border-color); padding: 0.15rem 0.55rem; border-radius: var(--radius-full);">
                  ★ 4.9 Average
                </span>
              </div>
              <div class="driver-reviews-list" id="driverReviewsList">
                <!-- Dynamically populated with 3 latest reviews -->
              </div>
            </div>
          </div>

          <!-- Trip Route & Fare Summary -->
          <div class="tip-summary-card">
            <div class="tsc-row">
              <span class="tsc-lbl">Pickup</span>
              <span class="tsc-val" id="tipSummaryPickup">Phase 7, Mohali</span>
            </div>
            <div class="tsc-row">
              <span class="tsc-lbl">Drop</span>
              <span class="tsc-val" id="tipSummaryDrop">Chandigarh Int'l Airport</span>
            </div>
            <div class="tsc-row">
              <span class="tsc-lbl">Ride Type &amp; Distance</span>
              <span class="tsc-val" id="tipSummaryRide">Mini &bull; ~6.8 km</span>
            </div>
            <div class="tsc-row tsc-fare-row">
              <span class="tsc-lbl">Fare to Pay</span>
              <span class="tsc-val tsc-fare-val" id="tipSummaryFare">₹152 (Cash/UPI)</span>
            </div>
          </div>

          <!-- Emergency Contacts Section (Saved for SOS Alerts) -->
          <div class="tip-contacts-card" id="tipEmergencyContactsCard">
            <div class="tcc-header">
              <h4 class="tcc-title">🛡️ Emergency SOS Contacts</h4>
              <span class="tcc-badge">Notified on SOS</span>
            </div>
            <p class="tcc-desc">
              Save 2 emergency contacts. During an SOS alert, your live route and emergency notification are instantly dispatched to them.
            </p>
            <div class="tcc-contacts-grid">
              <!-- Contact 1 -->
              <div class="tcc-contact-box">
                <div class="tcc-contact-lbl">Contact 1 (Primary)</div>
                <div class="tcc-input-row">
                  <input type="text" id="sosContactName1" class="tcc-input" placeholder="Name (e.g. Amit Sharma)">
                  <input type="tel" id="sosContactPhone1" class="tcc-input" placeholder="Phone (e.g. 9814012345)" maxlength="12">
                </div>
              </div>
              <!-- Contact 2 -->
              <div class="tcc-contact-box">
                <div class="tcc-contact-lbl">Contact 2 (Secondary)</div>
                <div class="tcc-input-row">
                  <input type="text" id="sosContactName2" class="tcc-input" placeholder="Name (e.g. Simran Kaur)">
                  <input type="tel" id="sosContactPhone2" class="tcc-input" placeholder="Phone (e.g. 9876543210)" maxlength="12">
                </div>
              </div>
            </div>
            <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;">
              <div style="display: flex; align-items: center;">
                <button type="button" class="btn-save-contacts" id="btnSaveEmergencyContacts" onclick="saveEmergencyContacts()">
                  💾 Save Contacts
                </button>
                <span class="tcc-save-status" id="tccSaveStatus">✓ Contacts saved!</span>
              </div>
              <button type="button" class="btn-sos-cancel" style="color: #b91c1c; border-color: #fca5a5; background: #fef2f2; font-weight: 800; padding: 0.5rem 1rem;" onclick="openSosModal()">
                🚨 Trigger SOS
              </button>
            </div>
          </div>

          <!-- Completed Celebration Banner -->
          <div class="tip-completed-banner" id="tipCompletedBanner" style="display: none;">
            <div class="tcb-icon">🎉</div>
            <h3 class="tcb-title">Trip Completed!</h3>
            <p class="tcb-desc">You have safely reached your destination. Please pay ₹<span id="tipFinalPayVal">152</span> to the driver via cash or UPI.</p>
          </div>

          <!-- ==================== RATING SCREEN (Shown after Trip Completed) ==================== -->
          <div class="tip-rating-card" id="driverRatingCard" style="display: none;">
            <div class="trc-header">
              <span class="trc-eyebrow">Rate Your Experience</span>
              <h3 class="trc-title">How was your ride with <span id="rateDriverName">Gurpreet Singh</span>?</h3>
              <p class="trc-desc">Your rating helps drivers maintain high service standards in Mohali &amp; Chandigarh.</p>
            </div>

            <!-- Star Selector (1 to 5 stars) -->
            <div class="trc-stars-block">
              <div class="star-selector" id="driverStarSelector">
                <button type="button" class="star-btn active" data-rating="1" title="1 Star">★</button>
                <button type="button" class="star-btn active" data-rating="2" title="2 Stars">★</button>
                <button type="button" class="star-btn active" data-rating="3" title="3 Stars">★</button>
                <button type="button" class="star-btn active" data-rating="4" title="4 Stars">★</button>
                <button type="button" class="star-btn active" data-rating="5" title="5 Stars">★</button>
              </div>
              <span class="star-rating-label" id="starRatingLabel">5.0 &bull; Excellent</span>
            </div>

            <!-- Quick Tags -->
            <div class="trc-tags-block">
              <span class="trc-tags-title">What went well? (Select quick tags)</span>
              <div class="quick-tags-list" id="quickTagsList">
                <button type="button" class="quick-tag-btn active" data-tag="Safe driving">
                  <span class="qtb-check">✓</span> Safe driving
                </button>
                <button type="button" class="quick-tag-btn active" data-tag="Clean cab">
                  <span class="qtb-check">✓</span> Clean cab
                </button>
                <button type="button" class="quick-tag-btn" data-tag="On time">
                  <span class="qtb-check">✓</span> On time
                </button>
                <button type="button" class="quick-tag-btn" data-tag="Polite driver">
                  <span class="qtb-check">✓</span> Polite driver
                </button>
              </div>
            </div>

            <!-- Optional Comment Box -->
            <div class="trc-comment-block">
              <label for="driverRatingComment" class="trc-comment-lbl">Optional Comment</label>
              <textarea 
                id="driverRatingComment" 
                class="trc-textarea" 
                placeholder="Share any details about your trip, cleanliness, route, or driver courtesy (optional)..."
                rows="3"
              ></textarea>
            </div>

            <!-- Submit Button -->
            <div class="trc-actions">
              <button type="button" class="btn-submit-review" id="btnSubmitReview" onclick="submitDriverReview()">
                Submit Review
              </button>
            </div>
          </div>

          <!-- Thank You Message Card (Shown after submitting review) -->
          <div class="tip-thankyou-card" id="driverThankYouCard" style="display: none;">
            <div class="tyc-icon">🎉</div>
            <h3 class="tyc-title">Thank you for your review!</h3>
            <p class="tyc-desc">
              Your feedback has been added to <strong id="tycDriverName">Gurpreet Singh</strong>'s profile card below with the updated average rating.
            </p>
          </div>

          <!-- Trip Controls -->
          <div class="tip-controls-bar">
            <button type="button" class="btn-share-trip" id="btnShareTrip" onclick="openShareTripModal()">
              🔗 Share Trip
            </button>
            <button type="button" class="btn-cancel-trip" id="btnCancelTrip" onclick="handleCancelTrip()">
              ✕ Cancel Ride
            </button>
            <button type="button" class="btn-book-another-cab" id="btnBookAnotherCab" style="display: none;" onclick="resetCabBooking()">
              🚖 Book Another Ride
            </button>
            <button type="button" class="btn-cab-back-home" id="btnTripBackHome" style="display: none;" onclick="closeCabBookingSection()">
              Return to Services &rarr;
            </button>
          </div>

        </div>

      </div>
    </div>
  </section>

  <!-- =====================================================================
       4. PROVIDERS DIRECTORY SECTION
       ===================================================================== -->
  <section class="providers-section" id="providersSection">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Local Verified Pros</span>
        <h2 class="section-title" id="providersSectionTitle">Service Providers Near You</h2>
        <p class="section-desc">Showing verified professionals ready to serve you across Mohali, Chandigarh, and surrounding sectors.</p>
      </div>

      <!-- Filter Tabs Toolbar -->
      <div class="filter-toolbar">
        <div class="filter-pills-list" id="categoryFilterBar">
          <button type="button" class="filter-pill active" data-filter="all">All Services (41)</button>
          <button type="button" class="filter-pill" data-filter="ac-repair">AC Repair</button>
          <button type="button" class="filter-pill" data-filter="plumber">Plumber</button>
          <button type="button" class="filter-pill" data-filter="electrician">Electrician</button>
          <button type="button" class="filter-pill" data-filter="home-cleaner">Home Cleaner</button>
          <button type="button" class="filter-pill" data-filter="cab">Cab</button>
          <button type="button" class="filter-pill" data-filter="blood-test">Blood Test</button>
          <button type="button" class="filter-pill" data-filter="personal-chef">Personal Chef</button>
          <button type="button" class="filter-pill" data-filter="barber-home">Barber at Home</button>
          <button type="button" class="filter-pill" data-filter="massage-therapy">Massage Therapy</button>
          <button type="button" class="filter-pill" data-filter="painter">Painter</button>
          <button type="button" class="filter-pill" data-filter="labour-work">Labour Work</button>
        </div>
        <div class="providers-toolbar-right">
          <button type="button" class="id-filter-btn" id="filterIdVerifiedBtn" onclick="toggleIdVerifiedFilter()" title="Filter: Show only ID Verified providers">
            <span class="ifb-icon">🛡️</span>
            <span class="ifb-label">ID Verified Only</span>
            <span class="ifb-count" id="ifbCountBadge">18</span>
          </button>
          <div class="providers-count-text" id="providersCounter">Showing 24 providers</div>
        </div>
      </div>

      <!-- Home Visit Provider Gender Filter (Barber at Home & Massage Therapy) -->
      <div class="gender-filter-bar highlighted" id="genderFilterBar">
        <div class="gfb-label-group">
          <span class="gfb-icon">👤</span>
          <span class="gfb-label">Provider Gender:</span>
          <span class="gfb-badge">Barber & Massage Home Visits</span>
        </div>
        <div class="gender-pills-group" role="radiogroup" aria-label="Provider gender filter">
          <button type="button" 
                  class="gender-pill active" 
                  data-gender="all" 
                  onclick="setGenderFilter('all')"
                  title="Show providers of any gender">
            Any Gender
          </button>
          <button type="button" 
                  class="gender-pill" 
                  data-gender="male" 
                  onclick="setGenderFilter('male')"
                  title="Show male providers only">
            👨 Male
          </button>
          <button type="button" 
                  class="gender-pill" 
                  data-gender="female" 
                  onclick="setGenderFilter('female')"
                  title="Show female providers only">
            👩 Female
          </button>
        </div>
      </div>

      <!-- Providers Cards Grid -->
      <div class="providers-grid" id="providersGrid">
        <!-- Rendered dynamically from GET /api/providers/<service> -->
      </div>
    </div>
  </section>

  <!-- =====================================================================
       5. FOOTER
       ===================================================================== -->
  <footer class="site-footer">
    <div class="container">
      <div class="brand-group" style="justify-content: center; margin-bottom: 0.75rem;">
        <div class="brand-logo-icon" style="width: 32px; height: 32px; font-size: 1rem;">🏠</div>
        <div class="brand-title" style="font-size: 1.25rem;">Zen<span>serve</span></div>
      </div>
      <p class="footer-desc">
        Zenserve is an all-in-one home and local services directory specifically tailored for residents of Mohali, Chandigarh, and Panchkula (Tricity). Fast booking, direct contact, and zero upfront fee.
      </p>
      <div class="footer-pills">
        <span class="footer-pill">✓ 6 Core Services</span>
        <span class="footer-pill">✓ Verified Tricity Providers</span>
        <span class="footer-pill">✓ Flask REST Backend</span>
        <span class="footer-pill">✓ Pay After Service</span>
      </div>
      <div class="footer-bottom">
        &copy; 2026 Zenserve Tricity &bull; Built with Flask &amp; Single-Page Vanilla JavaScript.
      </div>
    </div>
  </footer>

  <!-- =====================================================================
       6. MODAL 1: BOOKING FORM MODAL
       ===================================================================== -->
  <div id="bookingModal" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="bmTitle">
    <div class="modal-dialog">
      <div class="modal-header">
        <div>
          <h3 class="modal-title" id="bmTitle">Schedule Service</h3>
          <p class="modal-subtitle">Direct booking with verified provider</p>
        </div>
        <button type="button" class="modal-close-btn" id="closeBookingModalBtn">&times;</button>
      </div>

      <div class="modal-body">
        <!-- Selected Provider Bar -->
        <div class="modal-provider-summary">
          <div>
            <div class="mps-name" id="modalProviderName">Provider Name</div>
            <div class="mps-service" id="modalServiceName">Service Category</div>
          </div>
          <div class="mps-price" id="modalPrice">₹299 onwards</div>
        </div>

        <form id="bookingForm" novalidate>
          <input type="hidden" id="bookProviderId">
          <input type="hidden" id="bookProviderName">
          <input type="hidden" id="bookService">
          <input type="hidden" id="bookPrice">

          <!-- Name & Phone -->
          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="custName">Your Full Name <span class="req">*</span></label>
              <input type="text" id="custName" class="form-input" placeholder="e.g. Priyanshu Sharma" required>
              <div class="field-error" id="custNameError">Please enter your name.</div>
            </div>

            <div class="form-group">
              <label class="form-label" for="custPhone">Phone Number <span class="req">*</span></label>
              <input type="tel" id="custPhone" class="form-input" placeholder="10-digit mobile number" maxlength="10" required>
              <div class="field-error" id="custPhoneError">Enter a valid 10-digit mobile.</div>
            </div>
          </div>

          <!-- Address -->
          <div class="form-group">
            <label class="form-label" for="custAddress">Service Address / Sector in Mohali or Chandigarh <span class="req">*</span></label>
            <input type="text" id="custAddress" class="form-input" placeholder="e.g. House 412, Phase 7, Mohali or Sector 35-B, Chandigarh" required>
            <div class="field-error" id="custAddressError">Please enter your complete address.</div>
            <div class="field-hint">Include house/flat number and Sector/Phase for fast navigation.</div>
          </div>

          <!-- Date & Time Slot -->
          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="bookDate">Service Date <span class="req">*</span></label>
              <input type="date" id="bookDate" class="form-input" required>
              <div class="field-error" id="bookDateError">Please select a valid date.</div>
            </div>

            <div class="form-group">
              <label class="form-label" for="bookTimeSlot">Preferred Slot <span class="req">*</span></label>
              <select id="bookTimeSlot" class="form-select" required>
                <option value="">Select a time slot</option>
                <option value="Morning (09:00 AM - 12:00 PM)">Morning (09:00 AM - 12:00 PM)</option>
                <option value="Afternoon (12:00 PM - 03:00 PM)">Afternoon (12:00 PM - 03:00 PM)</option>
                <option value="Evening (03:00 PM - 06:00 PM)">Evening (03:00 PM - 06:00 PM)</option>
                <option value="Late Evening (06:00 PM - 09:00 PM)">Late Evening (06:00 PM - 09:00 PM)</option>
              </select>
              <div class="field-error" id="bookTimeSlotError">Please select a slot.</div>
            </div>
          </div>

          <!-- Notes -->
          <div class="form-group">
            <label class="form-label" for="bookNotes">Problem Details / Instructions (Optional)</label>
            <textarea id="bookNotes" class="form-textarea" placeholder="e.g. AC cooling coil not working, tap in master bathroom leaking, etc."></textarea>
          </div>

          <!-- Trust Banner -->
          <div class="form-trust-banner">
            <span>🛡️</span>
            <span>Zero advance fee. Pay provider directly via Cash or UPI after service completion.</span>
          </div>
        </form>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn-secondary" id="cancelBookingBtn">Cancel</button>
        <button type="button" class="btn-primary" id="submitBookingBtn">Confirm Booking</button>
      </div>
    </div>
  </div>

  <!-- =====================================================================
       7. MODAL 2: CONFIRMATION SCREEN
       ===================================================================== -->
  <div id="confirmationModal" class="modal-overlay" role="dialog" aria-modal="true">
    <div class="modal-dialog">
      <div class="modal-header" style="justify-content: flex-end; padding-bottom: 0;">
        <button type="button" class="modal-close-btn" id="closeConfirmationBtn">&times;</button>
      </div>

      <div class="modal-body">
        <div class="confirmation-content">
          <div class="confirm-check-icon">✓</div>
          <h3 class="modal-title" style="font-size: 1.6rem; margin-bottom: 0.35rem;">Booking Confirmed!</h3>
          <p class="modal-subtitle">Your appointment has been scheduled with the provider.</p>

          <div class="confirm-id-pill">
            <span>Booking ID:</span>
            <strong id="confBookingId">ZS-00000</strong>
          </div>

          <div class="booking-summary-card">
            <div class="summary-row">
              <span class="summary-lbl">Service</span>
              <span class="summary-val" id="confService">AC Repair</span>
            </div>
            <div class="summary-row">
              <span class="summary-lbl">Provider</span>
              <span class="summary-val" id="confProvider">CoolTech Air Conditioning Care</span>
            </div>
            <div class="summary-row">
              <span class="summary-lbl">Date &amp; Slot</span>
              <span class="summary-val" id="confDateTime">Nov 02, 2026 &bull; Morning</span>
            </div>
            <div class="summary-row">
              <span class="summary-lbl">Address</span>
              <span class="summary-val" id="confAddress">Phase 7, Mohali</span>
            </div>
            <div class="summary-row">
              <span class="summary-lbl">Customer</span>
              <span class="summary-val" id="confCustomer">Priyanshu Sharma</span>
            </div>
            <div class="summary-row">
              <span class="summary-lbl">Estimated Price</span>
              <span class="summary-val" style="color: #000000;" id="confPrice">₹499 onwards (Pay after work)</span>
            </div>
          </div>
        </div>
      </div>

      <div class="modal-footer" style="justify-content: center; gap: 1rem;">
        <button type="button" class="btn-secondary" id="confDoneBtn">Done</button>
        <button type="button" class="btn-primary" id="confViewBookingsBtn">View My Bookings</button>
      </div>
    </div>
  </div>

  <!-- =====================================================================
       8. MODAL 3: MY BOOKINGS PAGE / MODAL
       ===================================================================== -->
  <div id="myBookingsModal" class="modal-overlay" role="dialog" aria-modal="true">
    <div class="modal-dialog" style="max-width: 650px;">
      <div class="modal-header">
        <div>
          <h3 class="modal-title">My Bookings</h3>
          <p class="modal-subtitle">Active and scheduled services in this session</p>
        </div>
        <button type="button" class="modal-close-btn" id="closeMyBookingsBtn">&times;</button>
      </div>

      <div class="modal-body">
        <div id="myBookingsContainer" class="my-bookings-list">
          <!-- Loaded dynamically from GET /api/bookings -->
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn-primary" id="closeMyBookingsDoneBtn" style="width: 100%;">Close</button>
      </div>
    </div>
  </div>

  <!-- =====================================================================
       8.1 MODAL 4: EMERGENCY SOS CONFIRMATION & ALERT MODAL
       ===================================================================== -->
  <div id="sosModal" class="modal-overlay" role="dialog" aria-modal="true" style="z-index: 1200;">
    <div class="modal-dialog sos-modal-dialog">
      <div class="modal-header" style="border-bottom: none; padding-bottom: 0;">
        <button type="button" class="modal-close-btn" onclick="closeSosModal()">&times;</button>
      </div>

      <div class="modal-body" style="padding-top: 0.5rem;">
        
        <!-- STEP 1: CONFIRMATION PROMPT -->
        <div id="sosConfirmState" class="sos-confirm-box">
          <div class="sos-warn-icon">🚨</div>
          <h3 class="sos-confirm-title">Send emergency alert?</h3>
          <p class="sos-confirm-desc">
            This will immediately send your live vehicle details (<strong id="sosPromptCab">CH 01 CB 4819</strong>), driver name (<strong id="sosPromptDriver">Gurpreet Singh</strong>), and current route to your 2 emergency contacts and the local police control room.
          </p>

          <div class="sos-confirm-actions">
            <button type="button" class="btn-sos-cancel" onclick="closeSosModal()">Cancel</button>
            <button type="button" class="btn-sos-confirm" onclick="confirmSendSosAlert()">
              🚨 Yes, Send Alert
            </button>
          </div>
        </div>

        <!-- STEP 2: ALERT DISPATCHED SUCCESS -->
        <div id="sosDispatchedState" class="sos-dispatched-box" style="display: none;">
          <div class="sos-alert-banner">
            <div style="font-size: 2.2rem; margin-bottom: 0.25rem;">📡</div>
            <h3 class="sos-alert-headline">Alert sent to your emergency contacts and local police (simulated)</h3>
            <p class="sos-alert-sub">Emergency alert broadcasted with your live trip telemetry.</p>
          </div>

          <!-- Emergency Contacts Notified List -->
          <div class="sos-contacts-notified-list">
            <div class="sos-notified-title">Contacts &amp; Authorities Alerted:</div>
            <div class="sos-notified-item">
              <span>👤</span>
              <span id="sosNotifiedContact1"><strong>Amit Sharma</strong> &bull; +91 98140 12345 (SMS &amp; Live GPS dispatched)</span>
            </div>
            <div class="sos-notified-item">
              <span>👤</span>
              <span id="sosNotifiedContact2"><strong>Simran Kaur</strong> &bull; +91 98765 43210 (SMS &amp; Live GPS dispatched)</span>
            </div>
            <div class="sos-notified-item">
              <span>🚓</span>
              <span><strong>Mohali &amp; Chandigarh Police PCR</strong> (CAD Telemetry Alert dispatched)</span>
            </div>
          </div>

          <!-- Tap to Call Buttons -->
          <div class="sos-call-buttons-group">
            <a href="tel:100" class="btn-sos-tap-call btn-sos-police">
              <span>🚓 Tap to Call Police (100)</span>
            </a>
            <a href="tel:1091" class="btn-sos-tap-call btn-sos-women">
              <span>🛡️ Tap to Call Women Helpline (1091)</span>
            </a>
          </div>

          <button type="button" class="btn-sos-cancel" style="width: 100%;" onclick="closeSosModal()">
            Close Alert Window
          </button>
        </div>

      </div>
    </div>
  </div>

  <!-- =====================================================================
       8.2 MODAL 5: SHARE LIVE TRIP MODAL
       ===================================================================== -->
  <div id="shareTripModal" class="modal-overlay" role="dialog" aria-modal="true" style="z-index: 1200;">
    <div class="modal-dialog" style="max-width: 500px;">
      <div class="modal-header">
        <div>
          <h3 class="modal-title">🔗 Share Live Trip</h3>
          <p class="modal-subtitle">Share your live tracking link &amp; ride details with anyone</p>
        </div>
        <button type="button" class="modal-close-btn" onclick="closeShareTripModal()">&times;</button>
      </div>

      <div class="modal-body">
        <label style="font-size: 0.82rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">
          Live Tracking Link
        </label>
        
        <div class="share-link-wrapper">
          <input type="text" id="shareTripLinkInput" class="share-link-input" readonly value="https://zenserve.app/track/ABC123">
          <button type="button" id="btnCopyTripLink" class="btn-copy-link" onclick="copyTripLink()">
            <span id="btnCopyTripLinkText">📋 Copy Link</span>
          </button>
        </div>

        <!-- WhatsApp Share Button -->
        <a href="#" id="btnShareWhatsApp" class="btn-whatsapp-share" target="_blank" rel="noopener">
          <span>💬 Share via WhatsApp</span>
        </a>

        <!-- Ride Details Card -->
        <div class="share-info-card">
          <div class="share-info-row">
            <span>Driver:</span>
            <span class="share-info-val" id="shareDriverName">Gurpreet Singh</span>
          </div>
          <div class="share-info-row">
            <span>Cab Number:</span>
            <span class="share-info-val" id="shareCabNumber">CH 01 CB 4819</span>
          </div>
          <div class="share-info-row">
            <span>Vehicle:</span>
            <span class="share-info-val" id="shareVehicleModel">White Maruti Swift Dzire</span>
          </div>
          <div class="share-info-row">
            <span>Route:</span>
            <span class="share-info-val" id="shareRouteSummary">Phase 7, Mohali ➔ Chandigarh Airport</span>
          </div>
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn-primary" style="width: 100%;" onclick="closeShareTripModal()">Done</button>
      </div>
    </div>
  </div>

  <!-- FLOATING RED SOS BUTTON (Visible during Trip in Progress) -->
  <button type="button" class="floating-sos-btn" id="floatingSosBtn" onclick="openSosModal()" aria-label="Emergency SOS">
    <span>🚨 SOS</span>
  </button>

  <!-- =====================================================================
       9. VANILLA JAVASCRIPT LOGIC
       ===================================================================== -->
  <!-- =====================================================================
       8.3 QUICK-ACCESS EMERGENCY PANEL (Dropdown on Laptop, Bottom Sheet on Mobile)
       ===================================================================== -->
  <div id="emergencyBackdrop" class="emergency-backdrop" onclick="closeEmergencyPanel()" aria-hidden="true"></div>

  <aside id="emergencyPanel" class="emergency-panel" role="dialog" aria-modal="true" aria-labelledby="emergencyPanelTitle">
    <div class="sheet-pull-handle" aria-hidden="true"></div>

    <div class="ep-header">
      <div class="ep-header-left">
        <span class="ep-badge-icon">🚨</span>
        <div>
          <h3 id="emergencyPanelTitle" class="ep-title">Quick Emergency SOS</h3>
          <p class="ep-subtitle">24x7 Helplines &bull; Mohali, Chandigarh &amp; Tricity</p>
        </div>
      </div>
      <button type="button" class="ep-close-btn" onclick="closeEmergencyPanel()" aria-label="Close Emergency Panel">&times;</button>
    </div>

    <div class="ep-content">
      <!-- =====================================================================
           SIMULATION: SEND EMERGENCY ALERT ACTION (Opens confirmation popup & simulated screen)
           ===================================================================== -->
      <div class="ep-alert-action-box">
        <button type="button" class="btn-send-emergency-alert" id="btnSendEmergencyAlert" onclick="openEmergencyAlertConfirm()">
          <div class="bsea-left">
            <span class="bsea-icon">🚨</span>
            <div class="bsea-text">
              <span class="bsea-title">Send Emergency Alert</span>
              <span class="bsea-sub">Alert your 3 saved contacts with GPS location</span>
            </div>
          </div>
          <span class="bsea-badge">SOS</span>
        </button>
      </div>

      <!-- 1. PERSONAL EMERGENCY CONTACTS (Up to 3, with Call and WhatsApp) -->
      <section class="ep-section ep-contacts-section">
        <div class="ep-sec-header">
          <div class="ep-sec-title-wrap">
            <span class="ep-sec-icon">🛡️</span>
            <h4 class="ep-sec-title">Personal Contacts</h4>
            <span class="ep-sec-count-badge" id="epContactsCountBadge">3 Saved</span>
          </div>
          <button type="button" class="ep-btn-edit-toggle" id="epBtnEditContacts" onclick="toggleEditEmergencyContacts()">
            ✏️ Edit
          </button>
        </div>

        <!-- Contacts Display Cards -->
        <div id="epContactsDisplayList" class="ep-contacts-list">
          <!-- Rendered dynamically from localStorage -->
        </div>

        <!-- Contacts Edit Form -->
        <div id="epContactsEditForm" class="ep-contacts-edit-form" style="display: none;">
          <p class="ep-edit-instructions">Save up to 3 trusted personal contacts for one-tap calling and WhatsApp SOS:</p>
          
          <div class="ep-contact-input-card">
            <label class="ep-input-label">Contact 1 (Primary):</label>
            <div class="ep-input-pair">
              <input type="text" id="epContactName1" class="ep-input-text" placeholder="Name (e.g. Papa / Amit)">
              <input type="tel" id="epContactPhone1" class="ep-input-text" placeholder="Phone (10 digits)" maxlength="12">
            </div>
          </div>

          <div class="ep-contact-input-card">
            <label class="ep-input-label">Contact 2:</label>
            <div class="ep-input-pair">
              <input type="text" id="epContactName2" class="ep-input-text" placeholder="Name (e.g. Simran Kaur)">
              <input type="tel" id="epContactPhone2" class="ep-input-text" placeholder="Phone (10 digits)" maxlength="12">
            </div>
          </div>

          <div class="ep-contact-input-card">
            <label class="ep-input-label">Contact 3:</label>
            <div class="ep-input-pair">
              <input type="text" id="epContactName3" class="ep-input-text" placeholder="Name (e.g. Rohit Verma)">
              <input type="tel" id="epContactPhone3" class="ep-input-text" placeholder="Phone (10 digits)" maxlength="12">
            </div>
          </div>

          <div class="ep-edit-actions">
            <button type="button" class="ep-btn-save-contacts" onclick="saveEmergencyPanelContacts()">
              💾 Save Contacts
            </button>
            <button type="button" class="ep-btn-cancel-edit" onclick="toggleEditEmergencyContacts(false)">
              Cancel
            </button>
          </div>
        </div>
      </section>

      <!-- 2. LARGE TAP-TO-CALL EMERGENCY HELPLINES (6 Numbers) -->
      <section class="ep-section ep-helplines-section">
        <div class="ep-sec-header">
          <div class="ep-sec-title-wrap">
            <span class="ep-sec-icon">⚡</span>
            <h4 class="ep-sec-title">Official Helplines</h4>
          </div>
          <span class="ep-tag-tollfree">24x7 Direct</span>
        </div>

        <div class="ep-helpline-grid">
          <!-- Police: 100 -->
          <a href="tel:100" class="ep-helpline-card card-police" title="Call Police (100)">
            <div class="ehc-icon-wrap">👮‍♂️</div>
            <div class="ehc-details">
              <span class="ehc-name">Police</span>
              <span class="ehc-sub">Law enforcement</span>
            </div>
            <div class="ehc-number-badge">100</div>
          </a>

          <!-- Fire Brigade: 101 -->
          <a href="tel:101" class="ep-helpline-card card-fire" title="Call Fire Brigade (101)">
            <div class="ehc-icon-wrap">🚒</div>
            <div class="ehc-details">
              <span class="ehc-name">Fire Brigade</span>
              <span class="ehc-sub">Rescue &amp; Fire</span>
            </div>
            <div class="ehc-number-badge">101</div>
          </a>

          <!-- Ambulance: 102 -->
          <a href="tel:102" class="ep-helpline-card card-ambulance" title="Call Ambulance (102)">
            <div class="ehc-icon-wrap">🚑</div>
            <div class="ehc-details">
              <span class="ehc-name">Ambulance</span>
              <span class="ehc-sub">Medical trauma</span>
            </div>
            <div class="ehc-number-badge">102</div>
          </a>

          <!-- Unified Emergency Number: 112 -->
          <a href="tel:112" class="ep-helpline-card card-unified" title="Call Unified Emergency (112)">
            <div class="ehc-icon-wrap">🚨</div>
            <div class="ehc-details">
              <span class="ehc-name">Unified SOS</span>
              <span class="ehc-sub">All-in-one helpline</span>
            </div>
            <div class="ehc-number-badge">112</div>
          </a>

          <!-- Women Helpline: 1091 -->
          <a href="tel:1091" class="ep-helpline-card card-women" title="Call Women Helpline (1091)">
            <div class="ehc-icon-wrap">👩</div>
            <div class="ehc-details">
              <span class="ehc-name">Women Helpline</span>
              <span class="ehc-sub">Safety &amp; support</span>
            </div>
            <div class="ehc-number-badge">1091</div>
          </a>

          <!-- Child Helpline: 1098 -->
          <a href="tel:1098" class="ep-helpline-card card-child" title="Call Child Helpline (1098)">
            <div class="ehc-icon-wrap">🧒</div>
            <div class="ehc-details">
              <span class="ehc-name">Child Helpline</span>
              <span class="ehc-sub">Child care &amp; rescue</span>
            </div>
            <div class="ehc-number-badge">1098</div>
          </a>
        </div>
      </section>

      <!-- 3. SHARE MY LOCATION (Browser Geolocation API + WhatsApp) -->
      <section class="ep-section ep-location-section">
        <div class="ep-sec-header">
          <div class="ep-sec-title-wrap">
            <span class="ep-sec-icon">📍</span>
            <h4 class="ep-sec-title">Share My Location</h4>
          </div>
        </div>

        <div class="ep-location-box">
          <!-- Initial Button -->
          <button type="button" id="btnShareLocation" class="btn-share-location" onclick="handleDetectLocation()">
            <span class="bsl-icon">📍</span>
            <span>Detect &amp; Share My Location</span>
          </button>

          <!-- Loading State -->
          <div id="epLocLoading" class="ep-loc-status-box" style="display: none;">
            <span class="ep-loc-spinner"></span>
            <span>Detecting your GPS coordinates...</span>
          </div>

          <!-- Success State -->
          <div id="epLocSuccess" class="ep-loc-result-card" style="display: none;">
            <div class="elr-row">
              <span class="elr-label">Coordinates:</span>
              <span id="epLocCoords" class="elr-val">30.7046° N, 76.7179° E</span>
            </div>
            <div class="elr-actions">
              <a id="epLocMapsLink" href="#" target="_blank" rel="noopener" class="btn-maps-link">
                🗺️ Google Maps
              </a>
              <a id="epLocWhatsAppBtn" href="#" target="_blank" rel="noopener" class="btn-wa-location">
                💬 Send via WhatsApp
              </a>
            </div>
          </div>

          <!-- Error / Denied State -->
          <div id="epLocError" class="ep-loc-error-card" style="display: none;">
            <div class="ele-icon">⚠️</div>
            <div class="ele-msg" id="epLocErrorMsg">
              Location access was denied. Please allow location access in your browser or device settings, or state your sector/landmark directly to the operator.
            </div>
            <button type="button" class="btn-retry-loc" onclick="handleDetectLocation()">
              🔄 Try Again
            </button>
          </div>
        </div>
      </section>

      <!-- 4. QUICK DETAILS ("What to tell the operator") -->
      <section class="ep-section ep-guide-section">
        <div class="ep-sec-header">
          <div class="ep-sec-title-wrap">
            <span class="ep-sec-icon">💡</span>
            <h4 class="ep-sec-title">What to Tell the Operator</h4>
          </div>
        </div>

        <div class="ep-guide-card">
          <div class="ep-guide-item">
            <div class="egi-badge">1</div>
            <div class="egi-text">
              <strong>Your Location:</strong> Mention your sector, street, landmark, or house number in Mohali / Chandigarh.
            </div>
          </div>
          <div class="ep-guide-item">
            <div class="egi-badge">2</div>
            <div class="egi-text">
              <strong>Nature of Emergency:</strong> Clearly state if it is medical, fire, crime, or an accident, and if anyone is hurt.
            </div>
          </div>
          <div class="ep-guide-item">
            <div class="egi-badge">3</div>
            <div class="egi-text">
              <strong>Your Phone Number:</strong> Reconfirm your callback number in case the phone call disconnects.
            </div>
          </div>
        </div>
      </section>
    </div>
  </aside>

  <!-- =====================================================================
       8.4 SIMULATED EMERGENCY ALERT MODAL (Confirmation Popup & Countdown Screen)
       NOTE: THIS IS A CLIENT-SIDE SIMULATION ONLY.
       No real emergency calls, SMS messages, or police dispatches occur.
       ===================================================================== -->
  <div id="emergencyAlertModal" class="modal-overlay" role="dialog" aria-modal="true" style="z-index: 1250;">
    <div class="modal-dialog ea-modal-dialog">
      
      <!-- VIEW 1: CONFIRMATION POPUP -->
      <div id="eaConfirmView" class="ea-confirm-box">
        <div class="ea-confirm-icon-wrap">🚨</div>
        <h3 class="ea-confirm-title">Send Emergency Alert?</h3>
        <p class="ea-confirm-desc">
          This will simulate sending an instant SOS alert with your live GPS location to your saved personal emergency contacts and local emergency services.
        </p>

        <!-- Preview of saved contacts to receive alert -->
        <div class="ea-recipients-card">
          <div class="ea-recipients-lbl">
            <span>🛡️</span>
            <span>Alert will be dispatched to:</span>
          </div>
          <div class="ea-recipients-list" id="eaConfirmRecipientsList">
            <!-- Dynamically populated from saved contacts -->
          </div>
          <div class="ea-loc-preview">
            <span>📍</span>
            <span>Location: Mohali &amp; Chandigarh (30.7046° N, 76.7179° E)</span>
          </div>
        </div>

        <div class="ea-confirm-actions">
          <button type="button" class="btn-ea-cancel" onclick="closeEmergencyAlertModal()">
            Cancel
          </button>
          <button type="button" class="btn-ea-confirm" onclick="startSimulatedEmergencyAlert()">
            🚨 Yes, Send Alert
          </button>
        </div>
      </div>

      <!-- VIEW 2: SIMULATED ACTIVE ALERT SCREEN (With Countdown & Cancel Button) -->
      <div id="eaActiveView" class="ea-active-box" style="display: none;">
        
        <!-- Header Banner: "Alert sent to your saved contacts with your location" -->
        <div class="ea-active-header">
          <div class="ea-active-icon">📡</div>
          <h3 class="ea-active-title">Alert sent to your saved contacts with your location</h3>
          <p class="ea-active-subtitle">
            ✓ Live GPS route &amp; urgent SOS alert successfully dispatched (Simulated)
          </p>
        </div>

        <!-- Countdown Timer Card -->
        <div class="ea-countdown-card">
          <div class="ea-countdown-lbl">⏱️ Escalation Countdown Timer</div>
          <span id="eaCountdownDigits" class="ea-countdown-digits">00:20</span>
          <p class="ea-countdown-desc" id="eaCountdownStatusText">
            Auto-escalating simulated alert to Mohali / Chandigarh Police Control Room (112) unless cancelled.
          </p>
          <div class="ea-progress-track">
            <div id="eaProgressBar" class="ea-progress-bar"></div>
          </div>
        </div>

        <!-- Dispatched Contacts List -->
        <div class="ea-dispatched-card">
          <div style="font-weight: 800; font-size: 0.76rem; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.4rem;">
            Dispatched Recipients:
          </div>
          <div id="eaDispatchedContactsList">
            <!-- Dynamically populated -->
          </div>
          <div style="margin-top: 0.45rem; color: #000000; font-size: 0.78rem; font-weight: 700;">
            📍 Live telemetry link: zenserve.app/sos/track/TRC-9481
          </div>
        </div>

        <!-- Prominent Cancel Alert Button -->
        <button type="button" class="btn-ea-cancel-alert" id="btnCancelActiveAlert" onclick="cancelSimulatedAlert()">
          <span>🛑</span>
          <span>Cancel Alert</span>
        </button>
      </div>

    </div>
  </div>


  <script>

    // =========================================================================
    // LIGHT / DARK THEME MANAGER
    // Persists choice in localStorage under key 'zenserve_theme'
    // =========================================================================
    function getStoredTheme() {
      try {
        return localStorage.getItem('zenserve_theme') || 'light';
      } catch (e) {
        return 'light';
      }
    }

    function applyTheme(theme) {
      const root = document.documentElement;
      const iconEl = document.getElementById('themeToggleIcon');
      const textEl = document.getElementById('themeToggleText');
      const toggleBtn = document.getElementById('themeToggleBtn');

      if (theme === 'dark') {
        root.setAttribute('data-theme', 'dark');
        if (iconEl) iconEl.textContent = '☀️';
        if (textEl) textEl.textContent = 'Light';
        if (toggleBtn) {
          toggleBtn.setAttribute('title', 'Switch to Light Mode');
          toggleBtn.setAttribute('aria-label', 'Switch to Light Mode');
        }
      } else {
        root.setAttribute('data-theme', 'light');
        if (iconEl) iconEl.textContent = '🌙';
        if (textEl) textEl.textContent = 'Dark';
        if (toggleBtn) {
          toggleBtn.setAttribute('title', 'Switch to Dark Mode');
          toggleBtn.setAttribute('aria-label', 'Switch to Dark Mode');
        }
      }

      try {
        localStorage.setItem('zenserve_theme', theme);
      } catch (e) {}
    }

    function toggleTheme() {
      const current = document.documentElement.getAttribute('data-theme') || 'light';
      const nextTheme = current === 'dark' ? 'light' : 'dark';
      applyTheme(nextTheme);
    }

    // Global Application State
    const state = {
      services: [],
      providers: [],
      activeFilter: 'all',
      searchQuery: '',
      bookingsCount: 0,
      idVerifiedOnly: false,
      selectedSubservices: {},
      chefMonthlyPlans: {},
      genderFilter: 'all'
    };

    // DOM Elements Cache
    const dom = {
      servicesContainer: document.getElementById('servicesContainer'),
      providersGrid: document.getElementById('providersGrid'),
      providersCounter: document.getElementById('providersCounter'),
      providersSectionTitle: document.getElementById('providersSectionTitle'),
      categoryFilterBar: document.getElementById('categoryFilterBar'),
      genderFilterBar: document.getElementById('genderFilterBar'),
      searchInput: document.getElementById('searchInput'),
      bookingNavCount: document.getElementById('bookingNavCount'),
      
      // Booking Modal
      bookingModal: document.getElementById('bookingModal'),
      closeBookingModalBtn: document.getElementById('closeBookingModalBtn'),
      cancelBookingBtn: document.getElementById('cancelBookingBtn'),
      submitBookingBtn: document.getElementById('submitBookingBtn'),
      bookingForm: document.getElementById('bookingForm'),
      modalProviderName: document.getElementById('modalProviderName'),
      modalServiceName: document.getElementById('modalServiceName'),
      modalPrice: document.getElementById('modalPrice'),
      bookProviderId: document.getElementById('bookProviderId'),
      bookProviderName: document.getElementById('bookProviderName'),
      bookService: document.getElementById('bookService'),
      bookPrice: document.getElementById('bookPrice'),
      custName: document.getElementById('custName'),
      custPhone: document.getElementById('custPhone'),
      custAddress: document.getElementById('custAddress'),
      bookDate: document.getElementById('bookDate'),
      bookTimeSlot: document.getElementById('bookTimeSlot'),
      bookNotes: document.getElementById('bookNotes'),
      custNameError: document.getElementById('custNameError'),
      custPhoneError: document.getElementById('custPhoneError'),
      custAddressError: document.getElementById('custAddressError'),
      bookDateError: document.getElementById('bookDateError'),
      bookTimeSlotError: document.getElementById('bookTimeSlotError'),
      
      // Confirmation Modal
      confirmationModal: document.getElementById('confirmationModal'),
      closeConfirmationBtn: document.getElementById('closeConfirmationBtn'),
      confDoneBtn: document.getElementById('confDoneBtn'),
      confViewBookingsBtn: document.getElementById('confViewBookingsBtn'),
      confBookingId: document.getElementById('confBookingId'),
      confService: document.getElementById('confService'),
      confProvider: document.getElementById('confProvider'),
      confDateTime: document.getElementById('confDateTime'),
      confAddress: document.getElementById('confAddress'),
      confCustomer: document.getElementById('confCustomer'),
      confPrice: document.getElementById('confPrice'),
      
      // My Bookings Modal
      myBookingsModal: document.getElementById('myBookingsModal'),
      navMyBookingsBtn: document.getElementById('navMyBookingsBtn'),
      closeMyBookingsBtn: document.getElementById('closeMyBookingsBtn'),
      closeMyBookingsDoneBtn: document.getElementById('closeMyBookingsDoneBtn'),
      myBookingsContainer: document.getElementById('myBookingsContainer'),
      brandHomeTrigger: document.getElementById('brandHomeTrigger')
    };

    // Helper: Map icons to emoji / symbol
    function getServiceEmoji(icon) {
      switch (icon) {
        case 'snowflake': return '❄️';
        case 'wrench': return '🔧';
        case 'zap': return '⚡';
        case 'sparkles': return '🧹';
        case 'car': return '🚖';
        case 'droplet': return '🩸';
        case 'chef': case 'utensils': return '👨‍🍳';
        case 'scissors': case 'barber': return '✂️';
        case 'spa': case 'massage': return '💆‍♂️';
        case 'paintbrush': case 'painter': return '🎨';
        case 'hard-hat': case 'labour': case 'labour-work': return '👷';
        default: return '🛠️';
      }
    }

    // =========================================================================
    // API CALLS
    // =========================================================================

    // 1. Fetch 6 Services from GET /api/services
    async function loadServices() {
      try {
        const res = await fetch('/api/services');
        const data = await res.json();
        if (data.success) {
          state.services = data.services;
          renderServices(data.services);
        }
      } catch (err) {
        console.error('Failed to load services:', err);
      }
    }

    // 2. Fetch Providers from GET /api/providers/<service>
    async function loadProviders(serviceSlug = 'all') {
      try {
        const res = await fetch(`/api/providers/${serviceSlug}`);
        const data = await res.json();
        if (data.success) {
          state.providers = data.providers;
          renderProviders();
        }
      } catch (err) {
        console.error('Failed to load providers:', err);
      }
    }

    // 3. Fetch Bookings from GET /api/bookings
    async function loadBookings() {
      try {
        const res = await fetch('/api/bookings');
        const data = await res.json();
        if (data.success) {
          state.bookingsCount = data.count;
          if (dom.bookingNavCount) dom.bookingNavCount.textContent = data.count;
          renderMyBookings(data.bookings);
        }
      } catch (err) {
        console.error('Failed to load bookings:', err);
      }
    }

    // =========================================================================
    // RENDERING FUNCTIONS
    // =========================================================================

    // Render 6 Service Cards
    function renderServices(services) {
      if (!dom.servicesContainer) return;
      dom.servicesContainer.innerHTML = services.map(s => {
        const isCab = s.slug === 'cab' || s.slug === 'cab-booking';
        return `
        <div class="service-card ${state.activeFilter === s.slug ? 'active' : ''}" data-service="${s.slug}" onclick="${isCab ? 'openCabBookingSection()' : `selectServiceFilter('${s.slug}')`}">
          <div class="service-card-top">
            <div class="service-icon-box">${getServiceEmoji(s.icon)}</div>
            <span class="service-badge">${s.badge}</span>
          </div>
          <h3 class="service-title">${s.name}</h3>
          <p class="service-desc">${s.description}</p>
          <div class="service-footer">
            <div class="service-price">
              <span>Starts at</span><br>${s.starting_price}
            </div>
            <button type="button" class="btn-view-providers" onclick="event.stopPropagation(); ${isCab ? 'openCabBookingSection()' : `selectServiceFilter('${s.slug}')`}">
              ${isCab ? 'Book a Cab &rarr;' : 'View Providers &rarr;'}
            </button>
          </div>
        </div>
      `;
      }).join('');
    }

    // Toggle ID Verified Filter
    function toggleIdVerifiedFilter() {
      state.idVerifiedOnly = !state.idVerifiedOnly;
      const btn = document.getElementById('filterIdVerifiedBtn');
      if (btn) {
        if (state.idVerifiedOnly) {
          btn.classList.add('active');
          const iconEl = btn.querySelector('.ifb-icon');
          if (iconEl) iconEl.textContent = '✓';
        } else {
          btn.classList.remove('active');
          const iconEl = btn.querySelector('.ifb-icon');
          if (iconEl) iconEl.textContent = '🛡️';
        }
      }
      renderProviders();
    }


    // Toggle Selectable Sub-Service Chip on Provider Card
    function toggleSubserviceChip(btn, providerId, subserviceName) {
      if (!state.selectedSubservices) state.selectedSubservices = {};
      const isSelected = btn.classList.contains('selected');
      const parent = btn.closest('.subservices-chips-list');
      
      if (isSelected) {
        btn.classList.remove('selected');
        delete state.selectedSubservices[providerId];
      } else {
        if (parent) {
          parent.querySelectorAll('.subservice-chip').forEach(c => c.classList.remove('selected'));
        }
        btn.classList.add('selected');
        state.selectedSubservices[providerId] = subserviceName;
      }

      // Dynamically update WhatsApp link on this provider's card
      const card = document.getElementById(`card-${providerId}`);
      if (card) {
        const waBtn = card.querySelector('.btn-whatsapp');
        const p = state.providers.find(x => x.id === providerId);
        if (waBtn && p) {
          const selectedSub = state.selectedSubservices[providerId];
          const cleanWa = (p.whatsapp || p.phone || '').replace(/[^0-9]/g, '');
          const msg = selectedSub 
            ? `Hi ${p.name}, I would like to book your "${selectedSub}" service via Zenserve.` 
            : `Hi ${p.name}, I found your profile on Zenserve and would like to book your service.`;
          waBtn.href = `https://wa.me/${cleanWa}?text=${encodeURIComponent(msg)}`;
        }
      }
    }


    // Toggle Monthly Plan on Personal Chef Cards
    function toggleChefMonthlyPlan(providerId) {
      if (!state.chefMonthlyPlans) state.chefMonthlyPlans = {};
      state.chefMonthlyPlans[providerId] = !state.chefMonthlyPlans[providerId];
      const isMonthly = state.chefMonthlyPlans[providerId];

      const card = document.getElementById(`card-${providerId}`);
      if (!card) {
        renderProviders();
        return;
      }

      const p = state.providers.find(x => x.id === providerId);
      if (!p) return;

      const monthlyPrice = p.monthlyPlanPrice || '₹6,000 / month';
      const monthlyDetails = p.monthlyPlanDetails || '2 meals a day (Lunch & Dinner)';
      const standardPrice = p.price;

      // Update toggle pill
      const toggleBtn = card.querySelector(`#chef-toggle-${providerId}`);
      if (toggleBtn) {
        toggleBtn.classList.toggle('active', isMonthly);
        toggleBtn.setAttribute('aria-pressed', isMonthly);
        const txt = toggleBtn.querySelector('.ctp-text');
        if (txt) txt.textContent = isMonthly ? 'MONTHLY ON' : 'MONTHLY PLAN';
      }

      // Update Pricing section
      const priceLabel = card.querySelector('.provider-price-label');
      const priceVal = card.querySelector('.provider-price-value');
      const priceSub = card.querySelector('.provider-price-sub');

      if (priceLabel) priceLabel.textContent = isMonthly ? 'Monthly Plan' : 'Pricing';
      if (priceVal) priceVal.textContent = isMonthly ? monthlyPrice : standardPrice;
      if (priceSub) {
        priceSub.textContent = isMonthly ? monthlyDetails : '';
        priceSub.style.display = isMonthly ? 'block' : 'none';
      }

      // Update Action Button between "Book Service" and "Start Plan →"
      const actionBtn = card.querySelector('.btn-book, .btn-start-plan');
      if (actionBtn) {
        if (isMonthly) {
          actionBtn.className = 'btn-start-plan';
          actionBtn.innerHTML = 'Start Plan &rarr;';
          actionBtn.setAttribute('onclick', `openBookingModal('${providerId}', true)`);
          actionBtn.setAttribute('title', `Start monthly meal plan with ${p.name}`);
        } else {
          actionBtn.className = 'btn-book';
          actionBtn.innerHTML = 'Book Service';
          actionBtn.setAttribute('onclick', `openBookingModal('${providerId}', false)`);
          actionBtn.setAttribute('title', `Book service with ${p.name}`);
        }
      }

      // Update WhatsApp link message
      const waBtn = card.querySelector('.btn-whatsapp');
      if (waBtn) {
        const cleanWa = (p.whatsapp || p.phone || '').replace(/[^0-9]/g, '');
        const waMsg = isMonthly 
          ? `Hi ${p.name}, I would like to start your Monthly Plan (${monthlyPrice} for 2 meals a day) via Zenserve.` 
          : `Hi ${p.name}, I found your profile on Zenserve and would like to book your service.`;
        waBtn.href = `https://wa.me/${cleanWa}?text=${encodeURIComponent(waMsg)}`;
      }
    }


    // Set Provider Gender Filter (Any, Male, Female)
    function setGenderFilter(gender) {
      state.genderFilter = gender;
      document.querySelectorAll('.gender-pill').forEach(btn => {
        btn.classList.toggle('active', btn.getAttribute('data-gender') === gender);
      });
      renderProviders();
    }

    // Render Providers with Search, Category Filter, and Badges
    function renderProviders() {
      if (!dom.providersGrid) return;
      
      const query = state.searchQuery.trim().toLowerCase();
      let list = [...state.providers];

      // Filter by ID Verified
      if (state.idVerifiedOnly) {
        list = list.filter(p => p.id_verified === true || (Array.isArray(p.badges) && p.badges.includes('ID Verified')));
      }

      // Filter by Gender (Any, Male, Female) - especially for Barber at Home and Massage Therapy
      if (state.genderFilter && state.genderFilter !== 'all') {
        list = list.filter(p => {
          if (p.gender) {
            return p.gender.toLowerCase() === state.genderFilter.toLowerCase();
          }
          // If viewing Barber or Massage and provider lacks gender, filter out
          if (['barber-home', 'massage-therapy'].includes(p.service_slug)) {
            return false;
          }
          return true;
        });
      }

      // Filter by text search
      if (query) {
        list = list.filter(p => 
          p.name.toLowerCase().includes(query) ||
          p.service.toLowerCase().includes(query) ||
          p.location.toLowerCase().includes(query) ||
          (p.features && p.features.some(f => f.toLowerCase().includes(query)))
        );
      }

      // Update Verified Providers Count Badge in Toolbar
      const verifiedTotal = state.providers.filter(p => p.id_verified === true || (Array.isArray(p.badges) && p.badges.includes('ID Verified'))).length;
      const countBadge = document.getElementById('ifbCountBadge');
      if (countBadge) countBadge.textContent = verifiedTotal;

      // Update counter text
      if (dom.providersCounter) {
        const notes = [];
        if (state.idVerifiedOnly) notes.push('ID Verified only');
        if (state.genderFilter && state.genderFilter !== 'all') notes.push(state.genderFilter.toUpperCase() + ' only');
        const filterNote = notes.length ? ` (${notes.join(', ')})` : '';
        dom.providersCounter.textContent = `Showing ${list.length} provider${list.length === 1 ? '' : 's'}${filterNote}`;
      }

      if (list.length === 0) {
        dom.providersGrid.innerHTML = `
          <div class="empty-state">
            <div class="empty-icon">🔍</div>
            <h4 class="empty-title">No providers found${state.searchQuery ? ` matching "${state.searchQuery}"` : ''}${state.idVerifiedOnly ? ' with ID Verified badge' : ''}</h4>
            <p class="empty-desc">Try clearing the ID Verified filter or searching for another sector in Mohali or Chandigarh.</p>
            <div style="display: flex; gap: 0.5rem; justify-content: center; flex-wrap: wrap; margin-top: 1rem;">
              ${state.genderFilter !== 'all' ? '<button type="button" class="btn-secondary" onclick="setGenderFilter(\'all\')">Show Any Gender</button>' : ''}
              ${state.idVerifiedOnly ? '<button type="button" class="btn-secondary" onclick="toggleIdVerifiedFilter()">Show All Providers</button>' : ''}
              <button type="button" class="btn-secondary" onclick="resetSearch()">View All Providers</button>
            </div>
          </div>
        `;
        return;
      }

      dom.providersGrid.innerHTML = list.map(p => {
        const badgesList = p.badges && p.badges.length ? p.badges : [
          ...(p.id_verified ? ['ID Verified'] : []),
          'Background Checked',
          'Rated 4.5+',
          'Insured Work'
        ];

        const isChef = p.service === 'Personal Chef' || p.service_slug === 'personal-chef' || p.category === 'Personal Chef';
        const isMonthly = isChef && Boolean(state.chefMonthlyPlans && state.chefMonthlyPlans[p.id]);
        const monthlyPrice = p.monthlyPlanPrice || '₹6,000 / month';
        const monthlyDetails = p.monthlyPlanDetails || '2 meals a day (Lunch & Dinner)';
        const displayPrice = isMonthly ? monthlyPrice : p.price;
        const displayPriceLabel = isMonthly ? 'Monthly Plan' : 'Pricing';

        const cleanPhone = (p.phone || '').replace(/[^0-9+]/g, '');
        const cleanWa = (p.whatsapp || p.phone || '').replace(/[^0-9]/g, '');
        const selectedSub = (state.selectedSubservices && state.selectedSubservices[p.id]) || '';
        
        let waMsg = `Hi ${p.name}, I found your profile on Zenserve and would like to book your service.`;
        if (isMonthly) {
          waMsg = `Hi ${p.name}, I would like to start your Monthly Plan (${monthlyPrice} for 2 meals a day) via Zenserve.`;
        } else if (selectedSub) {
          waMsg = `Hi ${p.name}, I would like to book your "${selectedSub}" service via Zenserve.`;
        }
        const waLink = `https://wa.me/${cleanWa}?text=${encodeURIComponent(waMsg)}`;

        const hasSubservices = p.subServices && Array.isArray(p.subServices) && p.subServices.length > 0;

        return `
        <article class="provider-card" id="card-${p.id}">
          <div>
            <div class="provider-header">
              <div class="provider-avatar">${p.name.charAt(0)}</div>
              <div class="provider-name-box">
                <h3 class="provider-name">${p.name}</h3>
                <div class="provider-meta">
                  <span class="provider-category-tag">${p.service}</span>
                  <span class="provider-exp">&bull; ${p.experience}</span>
                </div>
              </div>
              <div class="provider-rating-badge">★ ${p.rating}</div>
            </div>

            <!-- Provider Badges: ID Verified, Background Checked, Rated 4.5+, Insured Work, Carries own kit, Certified Therapist -->
            <div class="provider-badges-row">
              ${badgesList.map(b => {
                let icon = '✓';
                let cls = 'badge-verified';
                if (b === 'ID Verified') { icon = '🛡️'; cls = 'badge-verified'; }
                else if (b === 'Background Checked') { icon = '🔍'; cls = 'badge-bg'; }
                else if (b === 'Rated 4.5+') { icon = '⭐'; cls = 'badge-rating'; }
                else if (b === 'Insured Work') { icon = '🔒'; cls = 'badge-insured'; }
                else if (b === 'Carries own kit') { icon = '🧰'; cls = 'badge-kit'; }
                else if (b === 'Certified Therapist') { icon = '🏅'; cls = 'badge-certified'; }
                return `<span class="provider-badge ${cls}">${icon} ${b}</span>`;
              }).join('')}
              ${p.gender ? `<span class="provider-badge badge-gender">${p.gender === 'female' ? '👩 Female Pro' : '👨 Male Pro'}</span>` : ''}
            </div>

            <div class="provider-body">
              <div class="provider-location-row">
                <span class="provider-distance">📍 ${p.distance}</span>
                <span>&bull; ${p.location}</span>
              </div>
              <ul class="provider-features-list">
                ${(p.features || []).map(f => `<li class="provider-feature-tag">✓ ${f}</li>`).join('')}
              </ul>

              ${hasSubservices ? `
                <div class="provider-subservices-box">
                  <div class="subservices-header">
                    <span class="subservices-title">Services Available:</span>
                    <span class="subservices-hint">Tap to select</span>
                  </div>
                  <div class="subservices-chips-list">
                    ${p.subServices.map(sub => {
                      const isSel = !isMonthly && (selectedSub === sub);
                      const escapedSub = sub.replace(/'/g, "\\'");
                      return `
                        <button type="button" 
                                class="subservice-chip ${isSel ? 'selected' : ''}" 
                                data-provider="${p.id}" 
                                data-subservice="${sub}"
                                onclick="toggleSubserviceChip(this, '${p.id}', '${escapedSub}')"
                                title="Select ${sub}">
                          <span class="chip-check">✓ </span>${sub}
                        </button>
                      `;
                    }).join('')}
                  </div>
                </div>
              ` : ''}

              <!-- Personal Chef Monthly Plan Toggle -->
              ${isChef ? `
                <div class="chef-monthly-toggle-row">
                  <div class="cmtr-info">
                    <span class="cmtr-tag">SUBSCRIPTION SAVINGS</span>
                    <span class="cmtr-title">Monthly Plan (2 meals a day)</span>
                    <span class="cmtr-desc">${monthlyPrice} &bull; ${monthlyDetails}</span>
                  </div>
                  <button type="button" 
                          class="chef-toggle-pill ${isMonthly ? 'active' : ''}" 
                          id="chef-toggle-${p.id}"
                          onclick="toggleChefMonthlyPlan('${p.id}')" 
                          aria-pressed="${isMonthly}"
                          title="Toggle Monthly Plan for ${p.name}">
                    <span class="ctp-indicator"></span>
                    <span class="ctp-text">${isMonthly ? 'MONTHLY ON' : 'MONTHLY PLAN'}</span>
                  </button>
                </div>
              ` : ''}
            </div>
          </div>

          <div class="provider-footer">
            <div class="provider-price-box">
              <span class="provider-price-label">${displayPriceLabel}</span>
              <span class="provider-price-value">${displayPrice}</span>
              <span class="provider-price-sub" style="${isMonthly ? 'display:block;' : 'display:none;'}">${monthlyDetails}</span>
            </div>
            <div class="provider-actions">
              <a href="tel:${cleanPhone}" class="btn-call" title="Call Provider: ${p.phone}">
                📞
              </a>
              <a href="${waLink}" target="_blank" rel="noopener noreferrer" class="btn-whatsapp" title="WhatsApp Provider: ${p.name}">
                💬
              </a>
              ${isMonthly ? `
                <button type="button" class="btn-start-plan" onclick="openBookingModal('${p.id}', true)">
                  Start Plan &rarr;
                </button>
              ` : `
                <button type="button" class="btn-book" onclick="openBookingModal('${p.id}', false)">
                  Book Service
                </button>
              `}
            </div>
          </div>
        </article>
      `;
      }).join('');
    }

    // Render My Bookings
    function renderMyBookings(bookings) {
      if (!dom.myBookingsContainer) return;
      if (!bookings || bookings.length === 0) {
        dom.myBookingsContainer.innerHTML = `
          <div class="empty-state">
            <div class="empty-icon">📅</div>
            <h4 class="empty-title">No bookings in this session yet</h4>
            <p class="empty-desc">Choose any of the 6 services above to schedule a trusted provider in Mohali or Chandigarh.</p>
            <button type="button" class="btn-primary" onclick="closeModal('myBookingsModal'); scrollToSection('servicesSection');">
              Browse Services
            </button>
          </div>
        `;
        return;
      }

      dom.myBookingsContainer.innerHTML = bookings.map(b => `
        <div class="booking-item-card">
          <div class="bi-header">
            <span class="bi-id">${b.booking_id}</span>
            <span class="bi-status">✓ ${b.status}</span>
          </div>
          <h4 class="bi-title">${b.service} - ${b.provider_name}</h4>
          <p class="bi-provider">Estimated: <strong>${b.price}</strong> &bull; Pay After Service</p>
          <div class="bi-grid">
            <div class="bi-grid-item">
              <span>Appointment Slot</span>
              <strong>📅 ${b.booking_date}</strong>
              <div style="font-size: 0.78rem; color: #333333;">${b.time_slot}</div>
            </div>
            <div class="bi-grid-item">
              <span>Service Location</span>
              <strong>📍 ${b.customer_address}</strong>
              <div style="font-size: 0.78rem; color: #333333;">Contact: ${b.customer_phone}</div>
            </div>
          </div>
          ${b.notes ? `<div style="font-size: 0.8rem; color: #666666; margin-bottom: 0.5rem;"><em>Note: "${b.notes}"</em></div>` : ''}
          <div class="bi-time">Booked on: ${b.created_at}</div>
        </div>
      `).join('');
    }

    // =========================================================================
    // EVENT INTERACTIONS & LOGIC
    // =========================================================================

    // Filter Service
    function selectServiceFilter(serviceSlug) {
      state.activeFilter = serviceSlug;
      state.searchQuery = '';
      if (dom.searchInput) dom.searchInput.value = '';

      // Update Filter Bar Active Style
      document.querySelectorAll('.filter-pill').forEach(btn => {
        btn.classList.toggle('active', btn.getAttribute('data-filter') === serviceSlug);
      });

      // Update Service Cards Active Style
      document.querySelectorAll('.service-card').forEach(card => {
        card.classList.toggle('active', card.getAttribute('data-service') === serviceSlug);
      });

      // Update Gender Filter Bar visibility & highlight
      if (dom.genderFilterBar) {
        const isGenderRelevant = ['all', 'barber-home', 'massage-therapy'].includes(serviceSlug);
        dom.genderFilterBar.style.display = isGenderRelevant ? 'flex' : 'none';
        if (serviceSlug === 'barber-home' || serviceSlug === 'massage-therapy') {
          dom.genderFilterBar.classList.add('highlighted');
        } else {
          dom.genderFilterBar.classList.remove('highlighted');
        }
      }

      if (serviceSlug === 'cab' || serviceSlug === 'cab-booking') {
        openCabBookingSection();
      }

      // Load Providers for this service
      loadProviders(serviceSlug);

      // Smooth scroll to providers
      if (serviceSlug !== 'cab' && serviceSlug !== 'cab-booking') {
        scrollToSection('providersSection');
      }
    }

    // Handle Text Search
    function handleSearchSubmit() {
      const q = dom.searchInput ? dom.searchInput.value.trim() : '';
      state.searchQuery = q;
      
      // Switch filter to all so search operates across full database
      state.activeFilter = 'all';
      document.querySelectorAll('.filter-pill').forEach(btn => {
        btn.classList.toggle('active', btn.getAttribute('data-filter') === 'all');
      });

      loadProviders('all').then(() => {
        scrollToSection('providersSection');
      });
    }

    function resetSearch() {
      state.searchQuery = '';
      if (dom.searchInput) dom.searchInput.value = '';
      selectServiceFilter('all');
    }

    // Modal Helpers
    function openModal(modalId) {
      const m = document.getElementById(modalId);
      if (m) m.classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function closeModal(modalId) {
      const m = document.getElementById(modalId);
      if (m) m.classList.remove('active');
      document.body.style.overflow = '';
    }

    function scrollToSection(id) {
      const el = document.getElementById(id);
      if (el) el.scrollIntoView({ behavior: 'smooth' });
    }

    // Open Booking Modal for a specific provider
    function openBookingModal(providerId, isMonthlyPlan = false) {
      const provider = state.providers.find(p => p.id === providerId);
      if (!provider) return;

      const isChef = provider.service === 'Personal Chef' || provider.service_slug === 'personal-chef' || provider.category === 'Personal Chef';
      const monthlyActive = isMonthlyPlan || Boolean(state.chefMonthlyPlans && state.chefMonthlyPlans[providerId]);

      // Fill hidden & summary fields
      dom.bookProviderId.value = provider.id;
      dom.bookProviderName.value = provider.name;

      const bmTitle = document.getElementById('bmTitle');
      const bmSubtitle = document.querySelector('#bookingModal .modal-subtitle');

      if (isChef && monthlyActive) {
        const monthlyPrice = provider.monthlyPlanPrice || '₹6,000 / month';
        const monthlyDetails = provider.monthlyPlanDetails || '2 meals a day (Lunch & Dinner)';
        dom.bookService.value = `${provider.service} (Monthly Plan - 2 meals/day)`;
        dom.bookPrice.value = monthlyPrice;

        dom.modalServiceName.textContent = `${provider.service} • Monthly Subscription (2 meals/day)`;
        dom.modalPrice.textContent = monthlyPrice;
        if (bmTitle) bmTitle.textContent = 'Start Monthly Meal Plan';
        if (bmSubtitle) bmSubtitle.textContent = `Direct subscription: ${monthlyDetails} • ${monthlyPrice}`;

        if (dom.bookNotes) {
          dom.bookNotes.value = `Monthly Meal Plan Subscription: 2 meals a day (${monthlyDetails}). Starting today/selected date.`;
        }
      } else {
        dom.bookService.value = provider.service;
        dom.bookPrice.value = provider.price;

        dom.modalServiceName.textContent = `${provider.service} • ${provider.location}`;
        dom.modalPrice.textContent = provider.price;
        if (bmTitle) bmTitle.textContent = 'Schedule Service';
        if (bmSubtitle) bmSubtitle.textContent = 'Direct booking with verified provider';

        // Pre-fill notes if a subservice was selected
        const selectedSub = (state.selectedSubservices && state.selectedSubservices[providerId]) || '';
        if (dom.bookNotes) {
          dom.bookNotes.value = selectedSub ? `Selected Service: ${selectedSub}` : '';
        }
      }

      dom.modalProviderName.textContent = provider.name;

      // Set min date to today
      const today = new Date().toISOString().split('T')[0];
      dom.bookDate.min = today;
      if (!dom.bookDate.value) dom.bookDate.value = today;

      // Clear previous error messages
      [dom.custNameError, dom.custPhoneError, dom.custAddressError, dom.bookDateError, dom.bookTimeSlotError].forEach(e => {
        if (e) e.style.display = 'none';
      });

      openModal('bookingModal');
    }

    // Handle Booking Form Submit
    async function submitBooking() {
      let isValid = true;

      const name = dom.custName.value.trim();
      const phone = dom.custPhone.value.trim();
      const address = dom.custAddress.value.trim();
      const date = dom.bookDate.value;
      const timeSlot = dom.bookTimeSlot.value;
      const notes = dom.bookNotes.value.trim();

      // Validate Name
      if (!name) {
        dom.custNameError.style.display = 'block';
        isValid = false;
      } else {
        dom.custNameError.style.display = 'none';
      }

      // Validate Phone
      if (!phone || phone.replace(/\D/g, '').length < 10) {
        dom.custPhoneError.style.display = 'block';
        isValid = false;
      } else {
        dom.custPhoneError.style.display = 'none';
      }

      // Validate Address
      if (!address) {
        dom.custAddressError.style.display = 'block';
        isValid = false;
      } else {
        dom.custAddressError.style.display = 'none';
      }

      // Validate Date
      if (!date) {
        dom.bookDateError.style.display = 'block';
        isValid = false;
      } else {
        dom.bookDateError.style.display = 'none';
      }

      // Validate Time Slot
      if (!timeSlot) {
        dom.bookTimeSlotError.style.display = 'block';
        isValid = false;
      } else {
        dom.bookTimeSlotError.style.display = 'none';
      }

      if (!isValid) return;

      // Payload
      const payload = {
        service: dom.bookService.value,
        provider_id: dom.bookProviderId.value,
        provider_name: dom.bookProviderName.value,
        name: name,
        phone: phone,
        address: address,
        date: date,
        time_slot: timeSlot,
        notes: notes
      };

      // Disable button during submission
      dom.submitBookingBtn.disabled = true;
      dom.submitBookingBtn.textContent = 'Scheduling...';

      try {
        const res = await fetch('/api/book', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await res.json();
        if (data.success) {
          // Close booking modal
          closeModal('bookingModal');

          // Reset form fields
          dom.bookingForm.reset();

          // Populate Confirmation Modal
          dom.confBookingId.textContent = data.booking_id;
          dom.confService.textContent = data.booking.service;
          dom.confProvider.textContent = data.booking.provider_name;
          dom.confDateTime.textContent = `${data.booking.booking_date} • ${data.booking.time_slot}`;
          dom.confAddress.textContent = data.booking.customer_address;
          dom.confCustomer.textContent = `${data.booking.customer_name} (${data.booking.customer_phone})`;
          dom.confPrice.textContent = `${data.booking.price} (Pay after work)`;

          // Open Confirmation Modal
          openModal('confirmationModal');

          // Refresh Bookings counter & list
          loadBookings();
        } else {
          alert('Booking error: ' + (data.error || 'Failed to submit booking'));
        }
      } catch (err) {
        console.error('Submission failed:', err);
        alert('Server connection error. Please check if Flask server is running.');
      } finally {
        dom.submitBookingBtn.disabled = false;
        dom.submitBookingBtn.textContent = 'Confirm Booking';
      }
    }

