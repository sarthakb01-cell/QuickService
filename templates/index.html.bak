    const cabState = {
      pickup: '',
      drop: '',
      rideType: 'mini',
      ratePerKm: 15,
      baseFare: 50,
      rideName: 'Mini',
      rideIcon: '🚗',
      estDistanceKm: 6.8,
      estFare: 152,
      estEtaMin: 4,
      estDurationMin: 16,
      otp: '4829',
      driver: CAB_DRIVERS.mini,
      statusStep: 0,
      timerIds: []
    };

    function clearCabTimers() {
      if (cabState.timerIds && cabState.timerIds.length) {
        cabState.timerIds.forEach(id => clearTimeout(id));
        cabState.timerIds = [];
      }
    }

    function openCabBookingSection() {
      const section = document.getElementById('cabBookingSection');
      if (section) {
        section.style.display = 'block';
        section.scrollIntoView({ behavior: 'smooth', block: 'start' });
        if (document.getElementById('cabBookingFormView') && document.getElementById('cabBookingFormView').style.display !== 'none') {
          setTimeout(() => {
            const input = document.getElementById('cabPickupInput');
            if (input && !input.value) input.focus();
          }, 350);
        }
      }
    }

    function closeCabBookingSection() {
      const section = document.getElementById('cabBookingSection');
      if (section) {
        section.style.display = 'none';
      }
      const sosBtn = document.getElementById('floatingSosBtn');
      if (sosBtn) sosBtn.style.display = 'none';
      closeSosModal();
      closeShareTripModal();
      document.getElementById('servicesSection')?.scrollIntoView({ behavior: 'smooth' });
    }

    function calculateCabEstimate() {
      const pickup = (document.getElementById('cabPickupInput')?.value || '').trim();
      const drop = (document.getElementById('cabDropInput')?.value || '').trim();
      const fareBox = document.getElementById('cabFareEstimateBox');
      const emptyPrompt = document.getElementById('cabEmptyLocationsPrompt');
      const btnText = document.getElementById('btnBookCabText');
      const errorEl = document.getElementById('cabFormError');

      if (errorEl) errorEl.textContent = '';

      if (!pickup || !drop) {
        if (fareBox) fareBox.style.display = 'none';
        if (emptyPrompt) emptyPrompt.style.display = 'block';
        if (btnText) btnText.textContent = `🚖 Book Cab (${cabState.rideName})`;
        return false;
      }

      // Generate deterministic pseudo-distance based on location strings
      const hash = Math.abs((pickup.length * 7 + drop.length * 13) % 45);
      const distance = Number((4.5 + (hash / 10) * 1.6).toFixed(1));
      const fare = Math.round(cabState.baseFare + distance * cabState.ratePerKm);
      const eta = cabState.rideType === 'bike' ? 2 : cabState.rideType === 'auto' ? 3 : cabState.rideType === 'mini' ? 4 : 3;
      const duration = Math.round(distance * 2.2 + 4);

      cabState.pickup = pickup;
      cabState.drop = drop;
      cabState.estDistanceKm = distance;
      cabState.estFare = fare;
      cabState.estEtaMin = eta;
      cabState.estDurationMin = duration;

      if (fareBox) fareBox.style.display = 'block';
      if (emptyPrompt) emptyPrompt.style.display = 'none';

      const estFareEl = document.getElementById('cabEstFareVal');
      if (estFareEl) estFareEl.textContent = `₹${fare}`;

      const estEtaEl = document.getElementById('cabEstEtaVal');
      if (estEtaEl) estEtaEl.textContent = `⚡ Driver arriving in ${eta} mins`;

      const routeInfoEl = document.getElementById('cabRouteInfoVal');
      if (routeInfoEl) routeInfoEl.textContent = `Distance: ~${distance} km • Est. travel: ~${duration} mins`;

      if (btnText) btnText.textContent = `🚖 Book ${cabState.rideName} (₹${fare})`;

      return true;
    }

    function handleBookCabSubmit() {
      const pickup = (document.getElementById('cabPickupInput')?.value || '').trim();
      const drop = (document.getElementById('cabDropInput')?.value || '').trim();
      const errorEl = document.getElementById('cabFormError');

      if (!pickup || !drop) {
        if (errorEl) {
          errorEl.textContent = '⚠️ Please enter both pickup and drop locations to book your cab.';
        }
        return;
      }

      calculateCabEstimate();

      // Generate 4-digit OTP
      const otp = String(Math.floor(1000 + Math.random() * 9000));
      cabState.otp = otp;
      cabState.driver = CAB_DRIVERS[cabState.rideType] || CAB_DRIVERS.mini;

      // Switch to Trip In Progress View
      document.getElementById('cabBookingFormView').style.display = 'none';
      document.getElementById('cabTripProgressView').style.display = 'block';

      // Populate driver and trip cards
      const otpEl = document.getElementById('tipOtpDisplay');
      if (otpEl) otpEl.textContent = `${otp[0]}  ${otp[1]}  ${otp[2]}  ${otp[3]}`;

      const nameEl = document.getElementById('tipDriverName');
      if (nameEl) nameEl.textContent = cabState.driver.name;

      const ratingEl = document.getElementById('tipDriverRating');
      if (ratingEl) ratingEl.textContent = cabState.driver.rating;

      const carEl = document.getElementById('tipCarModel');
      if (carEl) carEl.textContent = cabState.driver.carModel;

      const cabNumEl = document.getElementById('tipCabNumber');
      if (cabNumEl) cabNumEl.textContent = cabState.driver.cabNumber;

      const avatarEl = document.getElementById('tipDriverAvatar');
      if (avatarEl) avatarEl.textContent = cabState.driver.avatar;

      const phoneBtn = document.getElementById('tipDriverPhoneBtn');
      if (phoneBtn) {
        phoneBtn.href = `tel:${cabState.driver.phone.replace(/[^0-9+]/g, '')}`;
        phoneBtn.innerHTML = `<span>📞 Call (${cabState.driver.phone})</span>`;
      }

      const sumPickup = document.getElementById('tipSummaryPickup');
      if (sumPickup) sumPickup.textContent = cabState.pickup;

      const sumDrop = document.getElementById('tipSummaryDrop');
      if (sumDrop) sumDrop.textContent = cabState.drop;

      const sumRide = document.getElementById('tipSummaryRide');
      if (sumRide) sumRide.textContent = `${cabState.rideName} • ~${cabState.estDistanceKm} km`;

      const sumFare = document.getElementById('tipSummaryFare');
      if (sumFare) sumFare.textContent = `₹${cabState.estFare} (Cash/UPI)`;

      const finalPay = document.getElementById('tipFinalPayVal');
      if (finalPay) finalPay.textContent = cabState.estFare;

      // Reset controls
      const btnCancel = document.getElementById('btnCancelTrip');
      const btnAnother = document.getElementById('btnBookAnotherCab');
      const btnBack = document.getElementById('btnTripBackHome');
      const completedBanner = document.getElementById('tipCompletedBanner');
      const otpCard = document.getElementById('tipOtpCard');

      if (btnCancel) btnCancel.style.display = 'inline-flex';
      if (btnAnother) btnAnother.style.display = 'none';
      if (btnBack) btnBack.style.display = 'none';
      if (completedBanner) completedBanner.style.display = 'none';
      if (otpCard) otpCard.style.opacity = '1';

      // Show floating red SOS button on trip in progress screen
      const sosBtn = document.getElementById('floatingSosBtn');
      if (sosBtn) sosBtn.style.display = 'inline-flex';

      // Load saved emergency contacts into input fields
      loadEmergencyContactsUI();

      // Start automatic fake status progression
      startCabStatusProgression();

      // Scroll to cab section
      document.getElementById('cabBookingSection')?.scrollIntoView({ behavior: 'smooth' });
    }

    function startCabStatusProgression() {
      clearCabTimers();

      const stages = [
        {
          title: 'Driver on the way',
          desc: `Driver is heading towards your pickup at ${cabState.pickup} (ETA ~${cabState.estEtaMin} mins)`,
          pulseColor: '#f59e0b',
          step: 0
        },
        {
          title: 'Driver arrived',
          desc: `Driver has reached your pickup point. Share OTP ${cabState.otp} to start the trip.`,
          pulseColor: '#3b82f6',
          step: 1
        },
        {
          title: 'Trip started',
          desc: `Trip in progress to ${cabState.drop} • Driving safely (~${cabState.estDurationMin} mins travel)`,
          pulseColor: '#10b981',
          step: 2
        },
        {
          title: 'Trip completed',
          desc: `You have arrived at ${cabState.drop}! Please pay ₹${cabState.estFare} directly to the driver.`,
          pulseColor: '#059669',
          step: 3
        }
      ];

      // Initial Stage: Driver on the way
      applyCabStatusStep(stages[0]);

      // Stage 1 at 4.5 seconds: Driver arrived
      cabState.timerIds.push(setTimeout(() => {
        applyCabStatusStep(stages[1]);
      }, 4500));

      // Stage 2 at 9 seconds: Trip started
      cabState.timerIds.push(setTimeout(() => {
        applyCabStatusStep(stages[2]);
      }, 9000));

      // Stage 3 at 14.5 seconds: Trip completed
      cabState.timerIds.push(setTimeout(() => {
        applyCabStatusStep(stages[3]);
      }, 14500));
    }

    function applyCabStatusStep(stage) {
      cabState.statusStep = stage.step;

      const titleEl = document.getElementById('tipStatusTitle');
      const descEl = document.getElementById('tipStatusDesc');
      const pulseDot = document.getElementById('tipPulseDot');

      if (titleEl) titleEl.textContent = stage.title;
      if (descEl) descEl.textContent = stage.desc;
      if (pulseDot) pulseDot.style.background = stage.pulseColor;

      for (let i = 0; i < 4; i++) {
        const stepEl = document.getElementById(`step-${i}`);
        const lineEl = document.getElementById(`line-${i}`);
        if (stepEl) {
          if (i < stage.step) {
            stepEl.className = 'tip-step completed';
          } else if (i === stage.step) {
            stepEl.className = 'tip-step active';
          } else {
            stepEl.className = 'tip-step';
          }
        }
        if (lineEl) {
          if (i < stage.step) {
            lineEl.className = 'tip-step-line filled';
          } else {
            lineEl.className = 'tip-step-line';
          }
        }
      }

      if (stage.step === 3) {
        const btnCancel = document.getElementById('btnCancelTrip');
        const btnAnother = document.getElementById('btnBookAnotherCab');
        const btnBack = document.getElementById('btnTripBackHome');
        const completedBanner = document.getElementById('tipCompletedBanner');
        const otpCard = document.getElementById('tipOtpCard');
        const ratingCard = document.getElementById('driverRatingCard');
        const thankYouCard = document.getElementById('driverThankYouCard');

        if (btnCancel) btnCancel.style.display = 'none';
        if (btnAnother) btnAnother.style.display = 'inline-flex';
        if (btnBack) btnBack.style.display = 'inline-flex';
        if (completedBanner) completedBanner.style.display = 'block';
        if (otpCard) otpCard.style.opacity = '0.5';

        // Show Driver Rating Card
        if (ratingCard) ratingCard.style.display = 'block';
        if (thankYouCard) thankYouCard.style.display = 'none';

        const rateDriverName = document.getElementById('rateDriverName');
        if (rateDriverName && cabState.driver) rateDriverName.textContent = cabState.driver.name;

        initDriverRatingUI();
        renderDriverReviews();
      }
    }

    function handleCancelTrip() {
      if (confirm('Are you sure you want to cancel this cab booking?')) {
        resetCabBooking();
      }
    }

    function resetCabBooking() {
      clearCabTimers();
      document.getElementById('cabTripProgressView').style.display = 'none';
      document.getElementById('cabBookingFormView').style.display = 'block';
      document.getElementById('tipCompletedBanner').style.display = 'none';
      document.getElementById('btnCancelTrip').style.display = 'inline-flex';
      document.getElementById('btnBookAnotherCab').style.display = 'none';
      document.getElementById('btnTripBackHome').style.display = 'none';
      document.getElementById('tipOtpCard').style.opacity = '1';

      // Reset rating & reviews cards
      const ratingCard = document.getElementById('driverRatingCard');
      const thankYouCard = document.getElementById('driverThankYouCard');
      const reviewsPanel = document.getElementById('driverReviewsPanel');
      const commentInput = document.getElementById('driverRatingComment');
      if (ratingCard) ratingCard.style.display = 'none';
      if (thankYouCard) thankYouCard.style.display = 'none';
      if (reviewsPanel) reviewsPanel.style.display = 'none';
      if (commentInput) commentInput.value = '';

      // Hide floating SOS button and close SOS modal if open
      const sosBtn = document.getElementById('floatingSosBtn');
      if (sosBtn) sosBtn.style.display = 'none';
      closeSosModal();
      closeShareTripModal();
      cabState.trackCode = '';

      calculateCabEstimate();
    }

    // =========================================================================
    // DRIVER RATING & REVIEW SYSTEM
    // =========================================================================
    let currentSelectedRating = 5;

    function initDriverRatingUI() {
      currentSelectedRating = 5;
      updateStarDisplay(5);

      const starButtons = document.querySelectorAll('#driverStarSelector .star-btn');
      starButtons.forEach(btn => {
        btn.onclick = () => {
          const val = parseInt(btn.getAttribute('data-rating') || '5', 10);
          currentSelectedRating = val;
          updateStarDisplay(val);
        };
      });

      // Quick tags toggle
      const quickTags = document.querySelectorAll('#quickTagsList .quick-tag-btn');
      quickTags.forEach(tagBtn => {
        tagBtn.onclick = () => {
          tagBtn.classList.toggle('active');
        };
      });
    }

    function updateStarDisplay(val) {
      const starButtons = document.querySelectorAll('#driverStarSelector .star-btn');
      starButtons.forEach(btn => {
        const rating = parseInt(btn.getAttribute('data-rating') || '0', 10);
        if (rating <= val) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });

      const labelEl = document.getElementById('starRatingLabel');
      if (labelEl) {
        const labels = {
          1: '1.0 • Poor',
          2: '2.0 • Fair',
          3: '3.0 • Good',
          4: '4.0 • Very Good',
          5: '5.0 • Excellent'
        };
        labelEl.textContent = labels[val] || `${val}.0`;
      }
    }

    function renderDriverReviews() {
      const driver = cabState.driver;
      if (!driver) return;

      const panel = document.getElementById('driverReviewsPanel');
      const listEl = document.getElementById('driverReviewsList');
      const avgPill = document.getElementById('driverAvgScorePill');

      if (panel) panel.style.display = 'block';
      if (avgPill) avgPill.textContent = `★ ${Number(driver.baseRating).toFixed(1)} Average`;

      if (listEl && Array.isArray(driver.reviews)) {
        const top3 = driver.reviews.slice(0, 3);
        listEl.innerHTML = top3.map(r => `
          <div class="driver-review-item">
            <div class="dri-top">
              <span class="dri-author">${r.author}</span>
              <div class="dri-meta">
                <span class="dri-stars">${'★'.repeat(Math.round(r.rating))} ${Number(r.rating).toFixed(1)}</span>
                <span>&bull;</span>
                <span>${r.time}</span>
              </div>
            </div>
            ${r.tags && r.tags.length ? `
              <div class="dri-tags">
                ${r.tags.map(t => `<span class="dri-tag">✓ ${t}</span>`).join('')}
              </div>
            ` : ''}
            <div class="dri-comment">"${r.comment}"</div>
          </div>
        `).join('');
      }
    }

    function submitDriverReview() {
      const driver = cabState.driver;
      if (!driver) return;

      const rating = currentSelectedRating || 5;

      // Collect active quick tags
      const activeTags = [];
      document.querySelectorAll('#quickTagsList .quick-tag-btn.active').forEach(btn => {
        const tag = btn.getAttribute('data-tag');
        if (tag) activeTags.push(tag);
      });

      // Collect optional comment
      const commentInput = document.getElementById('driverRatingComment');
      const userComment = (commentInput ? commentInput.value : '').trim();
      const finalComment = userComment || (activeTags.length ? `Great experience! (${activeTags.join(', ')})` : 'Wonderful ride and courteous service.');

      // Calculate updated driver average rating
      const prevCount = driver.ratingCount || 100;
      const newCount = prevCount + 1;
      const newAvg = Number(((driver.baseRating * prevCount + rating) / newCount).toFixed(2));
      driver.baseRating = newAvg;
      driver.ratingCount = newCount;
      driver.rating = `★ ${newAvg.toFixed(1)} (${newCount}+ rides)`;

      // Prepend review to driver's reviews array
      if (!Array.isArray(driver.reviews)) driver.reviews = [];
      driver.reviews.unshift({
        author: 'You (Passenger)',
        rating: rating,
        time: 'Just now',
        comment: finalComment,
        tags: activeTags
      });

      // Update Driver Profile Card
      const driverRatingEl = document.getElementById('tipDriverRating');
      if (driverRatingEl) driverRatingEl.textContent = driver.rating;

      renderDriverReviews();

      // Hide rating card and show thank-you message
      const ratingCard = document.getElementById('driverRatingCard');
      const thankYouCard = document.getElementById('driverThankYouCard');
      const tycDriverName = document.getElementById('tycDriverName');

      if (ratingCard) ratingCard.style.display = 'none';
      if (thankYouCard) thankYouCard.style.display = 'block';
      if (tycDriverName) tycDriverName.textContent = driver.name;

      // Scroll to thank-you card
      thankYouCard?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    // =========================================================================
    // EMERGENCY SOS & CONTACTS ENGINE
    // =========================================================================
    const DEFAULT_EMERGENCY_CONTACTS = [
      { name: 'Amit Sharma', phone: '9814012345' },
      { name: 'Simran Kaur', phone: '9876543210' }
    ];

    function getEmergencyContacts() {
      try {
        const saved = localStorage.getItem('zenserve_emergency_contacts');
        if (saved) {
          const parsed = JSON.parse(saved);
          if (Array.isArray(parsed) && parsed.length >= 2) return parsed;
        }
      } catch (e) {}
      return DEFAULT_EMERGENCY_CONTACTS;
    }

    function loadEmergencyContactsUI() {
      const contacts = getEmergencyContacts();
      const n1 = document.getElementById('sosContactName1');
      const p1 = document.getElementById('sosContactPhone1');
      const n2 = document.getElementById('sosContactName2');
      const p2 = document.getElementById('sosContactPhone2');

      if (n1 && contacts[0]) n1.value = contacts[0].name || '';
      if (p1 && contacts[0]) p1.value = contacts[0].phone || '';
      if (n2 && contacts[1]) n2.value = contacts[1].name || '';
      if (p2 && contacts[1]) p2.value = contacts[1].phone || '';
    }

    function saveEmergencyContacts() {
      const n1 = (document.getElementById('sosContactName1')?.value || '').trim() || 'Emergency Contact 1';
      const p1 = (document.getElementById('sosContactPhone1')?.value || '').trim() || '9814012345';
      const n2 = (document.getElementById('sosContactName2')?.value || '').trim() || 'Emergency Contact 2';
      const p2 = (document.getElementById('sosContactPhone2')?.value || '').trim() || '9876543210';

      const updated = [
        { name: n1, phone: p1 },
        { name: n2, phone: p2 }
      ];

      try {
        localStorage.setItem('zenserve_emergency_contacts', JSON.stringify(updated));
      } catch (e) {}

      const statusEl = document.getElementById('tccSaveStatus');
      if (statusEl) {
        statusEl.style.display = 'inline-block';
        setTimeout(() => {
          statusEl.style.display = 'none';
        }, 2500);
      }
    }

    function openSosModal() {
      const modal = document.getElementById('sosModal');
      const confirmBox = document.getElementById('sosConfirmState');
      const dispatchedBox = document.getElementById('sosDispatchedState');
      
      // Reset view to confirmation prompt
      if (confirmBox) confirmBox.style.display = 'block';
      if (dispatchedBox) dispatchedBox.style.display = 'none';

      // Fill prompt with active driver & vehicle
      const cabPrompt = document.getElementById('sosPromptCab');
      const driverPrompt = document.getElementById('sosPromptDriver');
      if (cabPrompt) cabPrompt.textContent = cabState.driver ? cabState.driver.cabNumber : 'CH 01 CB 4819';
      if (driverPrompt) driverPrompt.textContent = cabState.driver ? cabState.driver.name : 'Gurpreet Singh';

      if (modal) {
        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
    }

    function closeSosModal() {
      const modal = document.getElementById('sosModal');
      if (modal) {
        modal.classList.remove('active');
        document.body.style.overflow = '';
      }
    }

    function confirmSendSosAlert() {
      const confirmBox = document.getElementById('sosConfirmState');
      const dispatchedBox = document.getElementById('sosDispatchedState');
      
      if (confirmBox) confirmBox.style.display = 'none';
      if (dispatchedBox) dispatchedBox.style.display = 'block';

      // Populate the 2 notified emergency contacts
      const contacts = getEmergencyContacts();
      const notif1 = document.getElementById('sosNotifiedContact1');
      const notif2 = document.getElementById('sosNotifiedContact2');

      if (notif1 && contacts[0]) {
        notif1.innerHTML = `<strong>${contacts[0].name}</strong> &bull; +91 ${contacts[0].phone} (SMS &amp; Live GPS dispatched)`;
      }
      if (notif2 && contacts[1]) {
        notif2.innerHTML = `<strong>${contacts[1].name}</strong> &bull; +91 ${contacts[1].phone} (SMS &amp; Live GPS dispatched)`;
      }
    }

    // =========================================================================
    // SHARE TRIP ENGINE
    // =========================================================================
    function generateTrackingCode() {
      const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
      let code = '';
      for (let i = 0; i < 6; i++) {
        code += chars.charAt(Math.floor(Math.random() * chars.length));
      }
      return code;
    }

    function openShareTripModal() {
      if (!cabState.trackCode) {
        cabState.trackCode = generateTrackingCode();
      }
      const trackingLink = `https://zenserve.app/track/${cabState.trackCode}`;
      cabState.trackingLink = trackingLink;

      const linkInput = document.getElementById('shareTripLinkInput');
      if (linkInput) linkInput.value = trackingLink;

      const driverName = cabState.driver ? cabState.driver.name : 'Gurpreet Singh';
      const cabNumber = cabState.driver ? cabState.driver.cabNumber : 'CH 01 CB 4819';
      const carModel = cabState.driver ? cabState.driver.carModel : 'White Maruti Swift Dzire';
      const pickup = cabState.pickup || 'Phase 7, Mohali';
      const drop = cabState.drop || 'Chandigarh Airport';

      const sDriver = document.getElementById('shareDriverName');
      if (sDriver) sDriver.textContent = driverName;
      const sCab = document.getElementById('shareCabNumber');
      if (sCab) sCab.textContent = cabNumber;
      const sVehicle = document.getElementById('shareVehicleModel');
      if (sVehicle) sVehicle.textContent = carModel;
      const sRoute = document.getElementById('shareRouteSummary');
      if (sRoute) sRoute.textContent = `${pickup} ➔ ${drop}`;

      const waBtn = document.getElementById('btnShareWhatsApp');
      if (waBtn) {
        const waMessage = `Hi! Track my live Zenserve cab ride.\n🚖 Driver: ${driverName}\n🔢 Cab Number: ${cabNumber}\n📍 Route: ${pickup} to ${drop}\n🔗 Live Tracking Link: ${trackingLink}`;
        waBtn.href = `https://wa.me/?text=${encodeURIComponent(waMessage)}`;
      }

      const copyBtnText = document.getElementById('btnCopyTripLinkText');
      const copyBtn = document.getElementById('btnCopyTripLink');
      if (copyBtnText) copyBtnText.textContent = '📋 Copy Link';
      if (copyBtn) copyBtn.classList.remove('copied');

      const modal = document.getElementById('shareTripModal');
      if (modal) {
        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
    }

    function closeShareTripModal() {
      const modal = document.getElementById('shareTripModal');
      if (modal) {
        modal.classList.remove('active');
        document.body.style.overflow = '';
      }
    }

    async function copyTripLink() {
      const link = cabState.trackingLink || (document.getElementById('shareTripLinkInput')?.value) || 'https://zenserve.app/track/ABC123';
      const copyBtnText = document.getElementById('btnCopyTripLinkText');
      const copyBtn = document.getElementById('btnCopyTripLink');

      try {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          await navigator.clipboard.writeText(link);
        } else {
          const input = document.getElementById('shareTripLinkInput');
          if (input) {
            input.select();
            document.execCommand('copy');
          }
        }
        if (copyBtnText) copyBtnText.textContent = '✓ Copied!';
        if (copyBtn) copyBtn.classList.add('copied');
        setTimeout(() => {
          if (copyBtnText) copyBtnText.textContent = '📋 Copy Link';
          if (copyBtn) copyBtn.classList.remove('copied');
        }, 2200);
      } catch (err) {
        if (copyBtnText) copyBtnText.textContent = '✓ Copied!';
      }
    }


    // =========================================================================
    // QUICK-ACCESS EMERGENCY PANEL & GEOLOCATION LOGIC
    // =========================================================================
    const DEFAULT_HEADER_SOS_CONTACTS = [
      { name: 'Amit Sharma (Papa)', phone: '9814012345' },
      { name: 'Simran Kaur', phone: '9876543210' },
      { name: 'Rohit Verma', phone: '9888812345' }
    ];

    function getEmergencyPanelContacts() {
      try {
        const saved = localStorage.getItem('zenserve_header_sos_contacts');
        if (saved) {
          const parsed = JSON.parse(saved);
          if (Array.isArray(parsed) && parsed.length > 0) return parsed;
        }
      } catch (e) {}
      return DEFAULT_HEADER_SOS_CONTACTS;
    }

    function renderEmergencyPanelContacts() {
      const contacts = getEmergencyPanelContacts();
      const listEl = document.getElementById('epContactsDisplayList');
      const badgeEl = document.getElementById('epContactsCountBadge');
      if (badgeEl) badgeEl.textContent = `${contacts.length} Saved`;

      if (!listEl) return;

      listEl.innerHTML = contacts.map((c, idx) => {
        const cleanPhone = (c.phone || '').replace(/[^0-9]/g, '');
        const waMsg = encodeURIComponent(`EMERGENCY ALERT: I need immediate help! Please call me right away. My phone: ${cleanPhone}`);
        return `
          <div class="ep-contact-item">
            <div class="ep-contact-info">
              <span class="ep-contact-name">${c.name || `Contact ${idx + 1}`}</span>
              <span class="ep-contact-phone">+91 ${cleanPhone}</span>
            </div>
            <div class="ep-contact-actions">
              <a href="tel:${cleanPhone}" class="ec-btn-call" title="Call ${c.name}">
                📞 Call
              </a>
              <a href="https://wa.me/91${cleanPhone}?text=${waMsg}" target="_blank" rel="noopener" class="ec-btn-wa" title="WhatsApp ${c.name}">
                💬 WhatsApp
              </a>
            </div>
          </div>
        `;
      }).join('');
    }

    function toggleEditEmergencyContacts(forceState) {
      const form = document.getElementById('epContactsEditForm');
      const btn = document.getElementById('epBtnEditContacts');
      if (!form) return;

      const willShow = forceState !== undefined ? forceState : (form.style.display === 'none');
      if (willShow) {
        form.style.display = 'block';
        if (btn) btn.textContent = '✕ Close';

        const contacts = getEmergencyPanelContacts();
        for (let i = 1; i <= 3; i++) {
          const nameInput = document.getElementById(`epContactName${i}`);
          const phoneInput = document.getElementById(`epContactPhone${i}`);
          const c = contacts[i - 1] || { name: '', phone: '' };
          if (nameInput) nameInput.value = c.name || '';
          if (phoneInput) phoneInput.value = c.phone || '';
        }
      } else {
        form.style.display = 'none';
        if (btn) btn.textContent = '✏️ Edit';
      }
    }

    function saveEmergencyPanelContacts() {
      const updated = [];
      for (let i = 1; i <= 3; i++) {
        const nameVal = (document.getElementById(`epContactName${i}`)?.value || '').trim();
        const phoneVal = (document.getElementById(`epContactPhone${i}`)?.value || '').trim();
        if (nameVal || phoneVal) {
          updated.push({
            name: nameVal || `Emergency Contact ${i}`,
            phone: phoneVal || '9814012345'
          });
        }
      }

      const finalContacts = updated.length ? updated : DEFAULT_HEADER_SOS_CONTACTS;
      try {
        localStorage.setItem('zenserve_header_sos_contacts', JSON.stringify(finalContacts));
      } catch (e) {}

      renderEmergencyPanelContacts();
      toggleEditEmergencyContacts(false);
    }


    // =========================================================================
    // SIMULATED EMERGENCY ALERT WORKFLOW
    // NOTE: THIS IS A CLIENT-SIDE SIMULATION ONLY.
    // No real cellular carriers, SMS gateways, or 112/police dispatchers are
    // contacted. This is a frontend simulation for testing emergency SOS flows.
    // =========================================================================
    let simAlertTimerId = null;
    let simAlertSecondsLeft = 20;
    const SIM_ALERT_TOTAL_SECONDS = 20;

    // Open confirmation popup
    function openEmergencyAlertConfirm() {
      // NOTE: Simulation confirmation popup
      const modal = document.getElementById('emergencyAlertModal');
      const confirmView = document.getElementById('eaConfirmView');
      const activeView = document.getElementById('eaActiveView');
      const recipientsList = document.getElementById('eaConfirmRecipientsList');

      // Populate preview of contacts who will receive simulated alert
      const contacts = getEmergencyPanelContacts();
      if (recipientsList) {
        recipientsList.innerHTML = contacts.map(c => `
          <div class="ea-recipient-row">
            <span><strong>${c.name}</strong></span>
            <span style="font-family: monospace; color: var(--text-muted);">+91 ${c.phone}</span>
          </div>
        `).join('');
      }

      if (confirmView) confirmView.style.display = 'block';
      if (activeView) activeView.style.display = 'none';

      if (modal) {
        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
    }

    // Close emergency alert modal & clear any active simulation timer
    function closeEmergencyAlertModal() {
      clearSimulatedAlertTimer();
      const modal = document.getElementById('emergencyAlertModal');
      if (modal) {
        modal.classList.remove('active');
        document.body.style.overflow = '';
      }
    }

    // Start simulated alert: shows screen "Alert sent to your saved contacts with your location" & countdown timer
    function startSimulatedEmergencyAlert() {
      // NOTE: Simulation start - switches to active alert telemetry screen
      const confirmView = document.getElementById('eaConfirmView');
      const activeView = document.getElementById('eaActiveView');
      const dispatchedList = document.getElementById('eaDispatchedContactsList');
      const contacts = getEmergencyPanelContacts();

      if (confirmView) confirmView.style.display = 'none';
      if (activeView) activeView.style.display = 'block';

      // Populate dispatched contacts with confirmation checks
      if (dispatchedList) {
        dispatchedList.innerHTML = contacts.map(c => `
          <div class="ea-dispatched-item">
            <span>👤 ${c.name} (+91 ${c.phone})</span>
            <span class="ea-dispatched-status">✓ Dispatched</span>
          </div>
        `).join('');
      }

      // Initialize countdown timer
      clearSimulatedAlertTimer();
      simAlertSecondsLeft = SIM_ALERT_TOTAL_SECONDS;
      updateCountdownDisplay();

      // Start tick interval (1 second decrement)
      simAlertTimerId = setInterval(() => {
        simAlertSecondsLeft -= 1;
        updateCountdownDisplay();

        if (simAlertSecondsLeft <= 0) {
          clearSimulatedAlertTimer();
          handleSimulatedAlertExpired();
        }
      }, 1000);
    }

    // Update digits & progress bar for countdown timer
    function updateCountdownDisplay() {
      const digitsEl = document.getElementById('eaCountdownDigits');
      const barEl = document.getElementById('eaProgressBar');
      
      const mm = String(Math.floor(simAlertSecondsLeft / 60)).padStart(2, '0');
      const ss = String(simAlertSecondsLeft % 60).padStart(2, '0');
      
      if (digitsEl) digitsEl.textContent = `${mm}:${ss}`;
      if (barEl) {
        const pct = Math.max(0, (simAlertSecondsLeft / SIM_ALERT_TOTAL_SECONDS) * 100);
        barEl.style.width = `${pct}%`;
      }
    }

    // Cancel the simulated emergency alert
    function cancelSimulatedAlert() {
      // NOTE: Simulation cancelled by user
      clearSimulatedAlertTimer();

      const digitsEl = document.getElementById('eaCountdownDigits');
      const statusText = document.getElementById('eaCountdownStatusText');
      const cancelBtn = document.getElementById('btnCancelActiveAlert');
      const barEl = document.getElementById('eaProgressBar');

      if (digitsEl) {
        digitsEl.textContent = 'CANCELLED';
        digitsEl.style.color = '#059669';
      }
      if (statusText) {
        statusText.textContent = '✓ Simulated emergency alert has been cancelled. All contacts notified that you are safe.';
        statusText.style.color = '#047857';
      }
      if (barEl) {
        barEl.style.width = '0%';
        barEl.style.background = '#10b981';
      }

      if (cancelBtn) {
        cancelBtn.innerHTML = '<span>✓</span><span>Alert Cancelled (Close)</span>';
        cancelBtn.style.borderColor = '#10b981';
        cancelBtn.style.color = '#047857';
        cancelBtn.onclick = () => closeEmergencyAlertModal();
      }

      // Auto close after brief confirmation
      setTimeout(() => {
        closeEmergencyAlertModal();
        // Reset button for next time
        if (cancelBtn) {
          cancelBtn.innerHTML = '<span>🛑</span><span>Cancel Alert</span>';
          cancelBtn.style.borderColor = '#dc2626';
          cancelBtn.style.color = '#dc2626';
          cancelBtn.onclick = () => cancelSimulatedAlert();
        }
        if (digitsEl) digitsEl.style.color = '#dc2626';
      }, 2000);
    }

    // Handle timer expiration (simulated escalation)
    function handleSimulatedAlertExpired() {
      // NOTE: Simulation timer finished
      const digitsEl = document.getElementById('eaCountdownDigits');
      const statusText = document.getElementById('eaCountdownStatusText');
      const cancelBtn = document.getElementById('btnCancelActiveAlert');

      if (digitsEl) digitsEl.textContent = 'ESCALATED';
      if (statusText) {
        statusText.textContent = 'Simulated escalation dispatched to emergency control center. Live tracking channel active.';
      }
      if (cancelBtn) {
        cancelBtn.innerHTML = '<span>🛑</span><span>End Emergency Alert</span>';
      }
    }

    function clearSimulatedAlertTimer() {
      if (simAlertTimerId) {
        clearInterval(simAlertTimerId);
        simAlertTimerId = null;
      }
    }

    function openEmergencyPanel() {
      const panel = document.getElementById('emergencyPanel');
      const backdrop = document.getElementById('emergencyBackdrop');
      const btn = document.getElementById('headerEmergencyBtn');

      if (panel) panel.classList.add('active');
      if (backdrop) backdrop.classList.add('active');
      if (btn) {
        btn.classList.add('active');
        btn.setAttribute('aria-expanded', 'true');
      }

      renderEmergencyPanelContacts();

      if (window.innerWidth <= 640) {
        document.body.style.overflow = 'hidden';
      }
    }

    function closeEmergencyPanel() {
      const panel = document.getElementById('emergencyPanel');
      const backdrop = document.getElementById('emergencyBackdrop');
      const btn = document.getElementById('headerEmergencyBtn');

      if (panel) panel.classList.remove('active');
      if (backdrop) backdrop.classList.remove('active');
      if (btn) {
        btn.classList.remove('active');
        btn.setAttribute('aria-expanded', 'false');
      }

      document.body.style.overflow = '';
    }

    function toggleEmergencyPanel() {
      const panel = document.getElementById('emergencyPanel');
      if (panel && panel.classList.contains('active')) {
        closeEmergencyPanel();
      } else {
        openEmergencyPanel();
      }
    }

    function handleDetectLocation() {
      const btn = document.getElementById('btnShareLocation');
      const loading = document.getElementById('epLocLoading');
      const success = document.getElementById('epLocSuccess');
      const errBox = document.getElementById('epLocError');
      const errMsg = document.getElementById('epLocErrorMsg');
      const coordsEl = document.getElementById('epLocCoords');
      const mapsLink = document.getElementById('epLocMapsLink');
      const waBtn = document.getElementById('epLocWhatsAppBtn');

      if (!navigator.geolocation) {
        if (errBox) errBox.style.display = 'block';
        if (errMsg) errMsg.textContent = 'Geolocation is not supported by your browser. Please mention your sector or landmark directly.';
        if (btn) btn.style.display = 'none';
        return;
      }

      if (btn) btn.style.display = 'none';
      if (errBox) errBox.style.display = 'none';
      if (success) success.style.display = 'none';
      if (loading) loading.style.display = 'flex';

      navigator.geolocation.getCurrentPosition(
        (position) => {
          if (loading) loading.style.display = 'none';
          const lat = position.coords.latitude.toFixed(5);
          const lon = position.coords.longitude.toFixed(5);
          const mapsUrl = `https://www.google.com/maps?q=${lat},${lon}`;
          const waText = encodeURIComponent(`I need help. My location: ${mapsUrl}`);

          if (coordsEl) coordsEl.textContent = `${lat}°, ${lon}°`;
          if (mapsLink) mapsLink.href = mapsUrl;
          if (waBtn) waBtn.href = `https://wa.me/?text=${waText}`;

          if (success) success.style.display = 'block';
          if (btn) {
            btn.style.display = 'flex';
            btn.innerHTML = '<span>🔄 Refresh My Location</span>';
          }
        },
        (error) => {
          if (loading) loading.style.display = 'none';
          if (errBox) errBox.style.display = 'block';
          if (btn) btn.style.display = 'none';

          let message = 'Unable to retrieve location. Please check your network or GPS.';
          if (error.code === error.PERMISSION_DENIED) {
            message = 'Location access was denied. Please allow location permissions in your browser or device settings, or state your sector/landmark directly to the operator.';
          } else if (error.code === error.TIMEOUT) {
            message = 'Location request timed out. Please try again or share your sector manually.';
          }
          if (errMsg) errMsg.textContent = message;
        },
        { enableHighAccuracy: true, timeout: 10000, maximumAge: 30000 }
      );
    }

    // =========================================================================
    // INITIALIZATION & EVENT LISTENERS
    // =========================================================================
    document.addEventListener('DOMContentLoaded', () => {
      // 1. Load initial services, providers and bookings
      applyTheme(getStoredTheme());
      loadServices();
      loadProviders('all');
      loadBookings();

      // 2. Filter Bar button clicks
      if (dom.categoryFilterBar) {
        dom.categoryFilterBar.addEventListener('click', (e) => {
          const btn = e.target.closest('.filter-pill');
          if (btn) {
            const filter = btn.getAttribute('data-filter');
            selectServiceFilter(filter);
          }
        });
      }

      // 3. Quick Chips in Hero
      document.querySelectorAll('.quick-chip').forEach(chip => {
        chip.addEventListener('click', () => {
          const val = chip.getAttribute('data-search');
          if (dom.searchInput) dom.searchInput.value = val;
          handleSearchSubmit();
        });
      });

      // 4. Live Search Input
      if (dom.searchInput) {
        dom.searchInput.addEventListener('input', (e) => {
          state.searchQuery = e.target.value;
          renderProviders();
        });
      }

      // 5. Booking Modal Controls
      if (dom.closeBookingModalBtn) dom.closeBookingModalBtn.addEventListener('click', () => closeModal('bookingModal'));
      if (dom.cancelBookingBtn) dom.cancelBookingBtn.addEventListener('click', () => closeModal('bookingModal'));
      if (dom.submitBookingBtn) dom.submitBookingBtn.addEventListener('click', submitBooking);

      // 6. Confirmation Modal Controls
      if (dom.closeConfirmationBtn) dom.closeConfirmationBtn.addEventListener('click', () => closeModal('confirmationModal'));
      if (dom.confDoneBtn) dom.confDoneBtn.addEventListener('click', () => closeModal('confirmationModal'));
      if (dom.confViewBookingsBtn) {
        dom.confViewBookingsBtn.addEventListener('click', () => {
          closeModal('confirmationModal');
          loadBookings();
          openModal('myBookingsModal');
        });
      }

      // 7. My Bookings Modal Controls
      if (dom.navMyBookingsBtn) {
        dom.navMyBookingsBtn.addEventListener('click', () => {
          loadBookings();
          openModal('myBookingsModal');
        });
      }
      if (dom.closeMyBookingsBtn) dom.closeMyBookingsBtn.addEventListener('click', () => closeModal('myBookingsModal'));
      if (dom.closeMyBookingsDoneBtn) dom.closeMyBookingsDoneBtn.addEventListener('click', () => closeModal('myBookingsModal'));

      // 8. Brand Click -> Home Scroll
      if (dom.brandHomeTrigger) {
        dom.brandHomeTrigger.addEventListener('click', () => {
          resetSearch();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }

      // 9. Close modals on backdrop click & ESC key
      document.querySelectorAll('.modal-overlay').forEach(modal => {
        modal.addEventListener('click', (e) => {
          if (e.target === modal) modal.classList.remove('active');
        });
      });

      // 10. Cab Booking Listeners
      document.querySelectorAll('.cab-ride-option').forEach(opt => {
        opt.addEventListener('click', () => {
          document.querySelectorAll('.cab-ride-option').forEach(o => o.classList.remove('active'));
          opt.classList.add('active');
          cabState.rideType = opt.getAttribute('data-ride-type');
          cabState.ratePerKm = Number(opt.getAttribute('data-rate'));
          cabState.baseFare = Number(opt.getAttribute('data-base'));
          cabState.rideName = opt.getAttribute('data-name');
          cabState.rideIcon = opt.getAttribute('data-icon');
          calculateCabEstimate();
        });
      });

      document.querySelectorAll('.cab-loc-chip').forEach(chip => {
        chip.addEventListener('click', () => {
          const targetId = chip.getAttribute('data-target');
          const val = chip.getAttribute('data-val');
          const input = document.getElementById(targetId);
          if (input) {
            input.value = val;
            calculateCabEstimate();
          }
        });
      });

      const currLocBtn = document.getElementById('btnUseCurrentCabLocation');
      if (currLocBtn) {
        currLocBtn.addEventListener('click', () => {
          const input = document.getElementById('cabPickupInput');
          if (input) {
            input.value = 'Current Location (Sector 35-B, Chandigarh)';
            calculateCabEstimate();
          }
        });
      }

      ['cabPickupInput', 'cabDropInput'].forEach(id => {
        const el = document.getElementById(id);
        if (el) {
          el.addEventListener('input', calculateCabEstimate);
          el.addEventListener('change', calculateCabEstimate);
        }
      });

      // 11. Initial load of saved emergency contacts
      loadEmergencyContactsUI();

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          closeModal('bookingModal');
          closeModal('confirmationModal');
          closeModal('myBookingsModal');
          closeSosModal();
          closeShareTripModal();
        }
      });
    });
  </script>
</body>
</html>
